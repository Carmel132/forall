-- Examples in the forall proof language.
-- Propositions P, Q are free atomic variables.
-- Quantifiers (∀/∃) are not yet supported by the parser.

-- An axiom is accepted without proof.
axiom refl : P → P

-- Modus ponens: from (P → Q) and P, conclude Q.
lemma modus_ponens : Q
proof
  suppose h1 : P → Q
  suppose h2 : P
  then Q by h1 and h2
end

-- Commutativity of conjunction: P ∧ Q implies Q ∧ P.
theorem and_comm : (P ∧ Q) → (Q ∧ P)
proof
  suppose h : P ∧ Q
  have hp : P by h
  have hq : Q by h
  have hqp : Q ∧ P by hq and hp
  then (P ∧ Q) → (Q ∧ P) by h and hqp
end
