-- Subsequence Limit Theorem
--
-- Let (a_n) be a sequence of reals and let L ∈ ℝ.
-- The following are equivalent:
--
--   (a)  (a_n) → L
--   (b)  Every subsequence of (a_n) → L
--
-- ── Why these are equivalent ────────────────────────────────────────────────
--
-- (a) → (b):  Given ε > 0, convergence of (a_n) yields N so that n ≥ N
--   implies |a_n − L| < ε.  For a subsequence (a_{φ(k)}), the indices
--   φ(k) are strictly increasing in ℕ, so φ(k) ≥ k ≥ K for any K ≥ N.
--   Hence |a_{φ(k)} − L| < ε for all k ≥ K.
--
-- (b) → (a):  (a_n) itself is a subsequence of (a_n) (take φ = identity).
--   If every subsequence converges to L then in particular (a_n) → L.
--
-- This file derives both directions from stdlib/analysis/subsequence.forall.
-- Sequences a, b and limit L are fixed as definitions; each proof
-- instantiates the relevant stdlib axiom via ForallElim (by h at t).

import "../stdlib/analysis/subsequence.forall"

-- Fix the sequences and limit for the duration of this file.
definition a : Nat -> Real
definition b : Nat -> Real
definition L : Real

-- ── Theorem 1 (a → b): convergence implies every subsequence converges ───────
--
-- subseq_converges : ∀ a b L, ConvergesTo(a,L) → IsSubsequence(a,b) → ConvergesTo(b,L)
-- Three ForallElim steps instantiate to fixed a, b, L.  Then two ImplElim
-- steps apply h_conv and h_sub.  The inner implication is built as a have
-- so the outer ImplIntro sees a single premise.

theorem seq_implies_subseq : ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
proof
  suppose h_conv : ConvergesTo(a, L)
  suppose h_sub  : IsSubsequence(a, b)
  have sc_a  : for all b : Nat -> Real, for all L : Real,
                   ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
               by subseq_converges at a
  have sc_ab : for all L : Real,
                   ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
               by sc_a at b
  have sc_abL : ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
                by sc_ab at L
  have sc_conv : IsSubsequence(a, b) -> ConvergesTo(b, L)
                 by sc_abL and h_conv
  have h_res  : ConvergesTo(b, L) by sc_conv and h_sub
  have inner  : IsSubsequence(a, b) -> ConvergesTo(b, L) by h_sub and h_res
  then ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
       by h_conv and inner
end

-- ── Theorem 2 (b → a): the identity subsequence recovers the original ────────
--
-- identity_is_subseq : ∀ a, IsSubsequence(a, a)
-- Given ConvergesTo(a, L), seq_implies_subseq with b := a gives ConvergesTo(a, L).
-- The propositional structure is trivial once IsSubsequence(a, a) is in scope.

theorem subseq_implies_seq : ConvergesTo(a, L) -> ConvergesTo(a, L)
proof
  suppose h_conv : ConvergesTo(a, L)
  have h_id   : IsSubsequence(a, a) by identity_is_subseq at a
  have sc_a   : for all b : Nat -> Real, for all L : Real,
                    ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
                by subseq_converges at a
  have sc_ab  : for all L : Real,
                    ConvergesTo(a, L) -> IsSubsequence(a, a) -> ConvergesTo(a, L)
                by sc_a at a
  have sc_abL : ConvergesTo(a, L) -> IsSubsequence(a, a) -> ConvergesTo(a, L)
                by sc_ab at L
  have sc_conv : IsSubsequence(a, a) -> ConvergesTo(a, L)
                 by sc_abL and h_conv
  then ConvergesTo(a, L) -> ConvergesTo(a, L) by h_conv and h_conv
end

-- ── Theorem 3 (biconditional — forward direction via seq_iff_subseq) ─────────
--
-- seq_iff_subseq : ∀ a L, ConvergesTo(a,L) → ∀ b, IsSubsequence(a,b) → ConvergesTo(b,L)
-- Two ForallElim steps instantiate to fixed a and L; two ImplElim steps
-- apply h_conv and h_sub.  Inner implication built as a have for ImplIntro.

theorem seq_iff_subseq_fwd :
    ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
proof
  suppose h_conv : ConvergesTo(a, L)
  suppose h_sub  : IsSubsequence(a, b)
  have sif_a  : for all L : Real,
                    ConvergesTo(a, L) ->
                        for all b : Nat -> Real, IsSubsequence(a, b) -> ConvergesTo(b, L)
                by seq_iff_subseq at a
  have sif_aL : ConvergesTo(a, L) ->
                    for all b : Nat -> Real, IsSubsequence(a, b) -> ConvergesTo(b, L)
                by sif_a at L
  have h_all  : for all b : Nat -> Real, IsSubsequence(a, b) -> ConvergesTo(b, L)
                by sif_aL and h_conv
  have h_impl : IsSubsequence(a, b) -> ConvergesTo(b, L)
                by h_all at b
  have h_res  : ConvergesTo(b, L) by h_impl and h_sub
  have inner  : IsSubsequence(a, b) -> ConvergesTo(b, L) by h_sub and h_res
  then ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
       by h_conv and inner
end
