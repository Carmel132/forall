-- Subsequence Limit Theorem
--
-- Let (a_n) be a sequence of reals and let L ∈ ℝ.
-- The following are equivalent:
--
--   (a)  (a_n) → L
--   (b)  Every subsequence of (a_n) → L
--
-- ── Why these are equivalent ────────────────────────────────────────────────
--
-- (a) → (b):  Given ε > 0, convergence of (a_n) yields N so that n ≥ N
--   implies |a_n − L| < ε.  For a subsequence (a_{φ(k)}), the indices
--   φ(k) are strictly increasing in ℕ, so φ(k) ≥ k ≥ K for any K ≥ N.
--   Hence |a_{φ(k)} − L| < ε for all k ≥ K.
--
-- (b) → (a):  (a_n) itself is a subsequence of (a_n) (take φ = identity).
--   If every subsequence converges to L then in particular (a_n) → L.
--
-- (b) → (a) is the trivial direction; (a) → (b) is where the proof lives.
-- Both directions together give the biconditional.
--
-- Since the language currently represents epsilon-delta quantifier arguments
-- as axioms (the type system needed for ∀ε∃N quantifier reasoning is not yet
-- implemented), we state the key analytic facts as axioms and validate the
-- propositional (logical) structure that assembles them.
--
-- Atomic propositions:
--
--   SeqConverges        (a_n) → L
--   SubseqConverges     every subsequence of (a_n) → L
--   IdentitySubseq      (a_n) is itself a subsequence of (a_n) (via φ = id)
--   IndexGrows          for a strictly-increasing φ : ℕ → ℕ, φ(k) ≥ k
--                         (this is the combinatorial fact φ(k) ≥ k for all k)

-- ── Field / order axioms used ────────────────────────────────────────────────

import "../stdlib/real.forall"

-- ── Analytic axioms ──────────────────────────────────────────────────────────

-- The identity map witnesses that (a_n) is a subsequence of itself.
axiom identity_is_subseq : IdentitySubseq

-- If (a_n) → L and φ is strictly increasing (IndexGrows), then for any ε > 0
-- the same N that works for (a_n) works for the subsequence (a_{φ(k)}).
-- Formally: SeqConverges ∧ IndexGrows → SubseqConverges.
-- Proof sketch: n ≥ N ⇒ |a_n − L| < ε; φ(k) ≥ k ≥ K for K = N, so
--   |a_{φ(k)} − L| < ε.
axiom convergent_subseq_converges : SeqConverges and IndexGrows -> SubseqConverges

-- Every strictly-increasing φ : ℕ → ℕ satisfies φ(k) ≥ k (by induction: φ(0) ≥ 0;
-- if φ(k) ≥ k then φ(k+1) > φ(k) ≥ k so φ(k+1) ≥ k+1).
axiom index_grows : IndexGrows

-- If (a_n) is a subsequence of (a_n) and every subsequence → L, then (a_n) → L.
axiom subseq_of_self_converges : IdentitySubseq and SubseqConverges -> SeqConverges

-- ── Theorem 1 (a → b): convergence implies every subsequence converges ───────

theorem seq_implies_subseq : SeqConverges -> SubseqConverges
proof
  suppose h_conv : SeqConverges
  have h_grows   : IndexGrows                  by index_grows
  have h_pair    : SeqConverges and IndexGrows by h_conv and h_grows
  have h_sub     : SubseqConverges             by convergent_subseq_converges and h_pair
  then SeqConverges -> SubseqConverges         by h_conv and h_sub
end

-- ── Theorem 2 (b → a): every subsequence converges implies convergence ───────
--
-- (a_n) is itself a subsequence (identity_is_subseq), so SubseqConverges
-- gives convergence of (a_n) directly via subseq_of_self_converges.

theorem subseq_implies_seq : SubseqConverges -> SeqConverges
proof
  suppose h_sub  : SubseqConverges
  have h_id      : IdentitySubseq                           by identity_is_subseq
  have h_pair    : IdentitySubseq and SubseqConverges       by h_id and h_sub
  have h_conv    : SeqConverges                             by subseq_of_self_converges and h_pair
  then SubseqConverges -> SeqConverges                      by h_sub and h_conv
end

-- ── Theorem 3 (biconditional): the full equivalence ─────────────────────────
--
-- Combines Theorem 1 and Theorem 2 via AndIntro.
-- The two implications give:  (SeqConverges → SubseqConverges) ∧
--                              (SubseqConverges → SeqConverges)
-- which is the biconditional SeqConverges ↔ SubseqConverges.

theorem seq_iff_subseq :
    (SeqConverges -> SubseqConverges) and (SubseqConverges -> SeqConverges)
proof
  suppose h_conv : SeqConverges
  have h_grows   : IndexGrows                  by index_grows
  have h_pair    : SeqConverges and IndexGrows by h_conv and h_grows
  have h_sub     : SubseqConverges             by convergent_subseq_converges and h_pair
  have fwd       : SeqConverges -> SubseqConverges  by h_conv and h_sub
  suppose h_sub2 : SubseqConverges
  have h_id      : IdentitySubseq                      by identity_is_subseq
  have h_pair2   : IdentitySubseq and SubseqConverges  by h_id and h_sub2
  have h_conv2   : SeqConverges                        by subseq_of_self_converges and h_pair2
  have bwd       : SubseqConverges -> SeqConverges     by h_sub2 and h_conv2
  then (SeqConverges -> SubseqConverges) and (SubseqConverges -> SeqConverges)
      by fwd and bwd
end
