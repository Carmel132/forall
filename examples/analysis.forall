-- Real Analysis: Convergence and Boundedness of Sequences
--
-- Atomic propositions name properties of a fixed sequence (a_n).
-- The epsilon-delta definitions for these properties live in
-- stdlib/analysis/sequence.forall (ConvergesTo, IsCauchy); here we use
-- abbreviated atomic names for sequences whose quantifier structure
-- is not being reasoned about directly.
--
--   Convergent  --  (a_n) has a finite limit
--   Cauchy      --  (a_n) is Cauchy
--   Bounded     --  (a_n) is bounded
--   Monotone    --  (a_n) is non-decreasing or non-increasing
--
-- These axioms are the standard results of real analysis.  Full epsilon-delta
-- proofs of each are in stdlib/analysis/ and examples/subsequence_limit.forall.
-- This file focuses on the propositional structure connecting them.

-- ── Domain axioms ─────────────────────────────────────────────────────────────

-- Every convergent sequence satisfies the Cauchy condition.
-- Proof: for eps > 0 choose N so |a_n - L| < eps/2 for n >= N;
-- the triangle inequality gives |a_m - a_n| < eps.
axiom cauchy_criterion : Convergent -> Cauchy

-- Every Cauchy sequence is bounded.
-- Proof: take eps = 1, find N; then |a_n| <= |a_N| + 1 for n >= N,
-- and the finitely many earlier terms are bounded by their maximum.
axiom cauchy_bounded : Cauchy -> Bounded

-- The Monotone Convergence Theorem: a bounded monotone sequence converges.
-- This is equivalent to the completeness of the reals.
axiom monotone_convergence : Bounded and Monotone -> Convergent

-- Completeness: every Cauchy sequence in R converges.
-- This fails in Q (e.g. rational approximations to sqrt(2)).
axiom completeness : Cauchy -> Convergent

-- ── Theorem 1: Convergent sequences are bounded ────────────────────────────────

theorem convergent_bounded : Convergent -> Bounded
proof
  suppose h_conv : Convergent
  have h_cauchy  : Cauchy             by cauchy_criterion and h_conv
  have h_bdd     : Bounded            by cauchy_bounded and h_cauchy
  then Convergent -> Bounded          by h_conv and h_bdd
end

-- ── Theorem 2: Unbounded sequences diverge ─────────────────────────────────────
--
-- Contrapositive of Theorem 1: if (a_n) is not bounded, it cannot converge.

theorem unbounded_diverges : not Bounded -> not Convergent
proof
  suppose h_unb  : not Bounded
  suppose h_conv : Convergent
  have h_cauchy  : Cauchy              by cauchy_criterion and h_conv
  have h_bdd     : Bounded             by cauchy_bounded and h_cauchy
  have h_bot     : false               by h_unb and h_bdd
  have h_nc      : not Convergent      by h_conv and h_bot
  then not Bounded -> not Convergent   by h_unb and h_nc
end

-- ── Theorem 3: Bounded monotone sequences are Cauchy ──────────────────────────
--
-- Monotone Convergence gives convergence; the Cauchy criterion then gives
-- the Cauchy property.

theorem monotone_bounded_is_cauchy : Bounded and Monotone -> Cauchy
proof
  suppose h_bm  : Bounded and Monotone
  have h_conv   : Convergent          by monotone_convergence and h_bm
  have h_cauchy : Cauchy              by cauchy_criterion and h_conv
  then Bounded and Monotone -> Cauchy by h_bm and h_cauchy
end

-- ── Theorem 4: In R, Cauchy iff Convergent ────────────────────────────────────
--
-- Both directions: Cauchy -> Convergent is completeness;
-- Convergent -> Cauchy is the Cauchy criterion.

theorem cauchy_iff_convergent : (Cauchy -> Convergent) and (Convergent -> Cauchy)
proof
  suppose h_c : Cauchy
  have h_v1   : Convergent            by completeness and h_c
  have fwd    : Cauchy -> Convergent  by h_c and h_v1
  suppose h_v : Convergent
  have h_c2   : Cauchy                by cauchy_criterion and h_v
  have bwd    : Convergent -> Cauchy  by h_v and h_c2
  then (Cauchy -> Convergent) and (Convergent -> Cauchy) by fwd and bwd
end

-- ── Theorem 5: Monotone + unbounded implies divergent ────────────────────────

theorem monotone_unbounded_diverges : Monotone -> not Bounded -> not Convergent
proof
  suppose h_mono : Monotone
  suppose h_unb  : not Bounded
  suppose h_conv : Convergent
  have h_cauchy  : Cauchy              by cauchy_criterion and h_conv
  have h_bdd     : Bounded             by cauchy_bounded and h_cauchy
  have h_bot     : false               by h_unb and h_bdd
  have h_nc      : not Convergent      by h_conv and h_bot
  have h_ub_nc   : not Bounded -> not Convergent  by h_unb and h_nc
  then Monotone -> not Bounded -> not Convergent  by h_mono and h_ub_nc
end
