-- Peano arithmetic for Nat
--
-- succ(n) is the successor of n.  The inductive declaration below
-- auto-generates the induction principle (Nat_ind) and the constructor
-- separation axioms (succ_ne_zero, zero_ne_succ, succ_injective).
-- Explicit axioms override the auto-generated ones where the literal 0
-- must appear instead of the constructor name "zero".
--
-- All declarations live in the Nat namespace; import this file and use
-- "open Nat" or qualified names like "Nat.add_zero".

namespace Nat

-- Declare Nat as an inductive type.  Auto-generates Nat_ind (induction
-- principle), succ_ne_zero, zero_ne_succ, succ_injective.
inductive Nat :=
  zero : Nat
  succ : Nat -> Nat

-- Override auto-generated succ_ne_zero/succ_injective with forms that use
-- the numeric literal 0 on the right-hand side, matching how proofs write 0.
axiom succ_ne_zero : for all n : Nat, not (succ(n) = 0)
axiom succ_injective : for all n : Nat, for all m : Nat, succ(n) = succ(m) implies n = m

-- Recursive characterisation of addition.
axiom add_zero : for all n : Nat, n + 0 = n
axiom add_succ : for all n : Nat, for all m : Nat, n + succ(m) = succ(n + m)

-- Recursive characterisation of multiplication.
axiom mul_zero : for all n : Nat, n * 0 = 0
axiom mul_succ : for all n : Nat, for all m : Nat, n * succ(m) = n * m + n

-- Order properties of successor.
axiom lt_succ : for all n : Nat, n < succ(n)
axiom le_of_lt_succ : for all n : Nat, for all m : Nat, n < succ(m) -> n <= m
axiom nat_le_zero : for all n : Nat, 0 <= n

-- Successor is never equal to its argument (structural property of Peano Nat).
axiom succ_ne_self : for all n : Nat, not (succ(n) = n)

-- Every natural number is zero or a successor (case-split axiom).
axiom nat_zero_or_succ :
    for all n : Nat, (n = 0) or (there exists m : Nat, n = succ(m))

-- The numeric literal 1 equals succ(0).
-- Needed to bridge between ExprLit{"1"} and ExprCall{"succ",[0]} in proofs.
axiom one_eq_succ_zero : 1 = succ(0)

-- Recursive characterisation of exponentiation.
axiom pow_zero : for all n : Nat, n ^ 0 = 1
axiom pow_succ : for all n : Nat, for all k : Nat, n ^ succ(k) = n ^ k * n

end Nat
