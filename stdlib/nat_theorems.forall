import "nat.forall"
open Nat

-- Derived theorems about natural numbers, proved from the Peano axioms.

-- 0 + n = n  (left identity of addition).
-- The symmetric axiom "add_zero" (n + 0 = n) is in nat.forall;
-- this direction requires induction.
theorem zero_add : for all n : Nat, 0 + n = n
proof
  induction result on n : 0 + n = n
    base:
      have az : 0 + 0 = 0 by add_zero at 0
      then 0 + 0 = 0 by az
    inductive:
      -- IH: ih : 0 + n = n
      -- Goal: 0 + succ(n) = succ(n)
      -- add_succ internal bound vars are 'n', 'm'; use 'm' to match after at 0
      have as1 : for all m : Nat, 0 + succ(m) = succ(0 + m) by add_succ at 0
      have as2 : 0 + succ(n) = succ(0 + n) by as1 at n
      have h_refl : succ(n) = succ(n) by refl
      have h_cong : succ(0 + n) = succ(n) by eq_subst ih and h_refl
      have h_trans : 0 + succ(n) = succ(n) by trans as2 and h_cong
      then 0 + succ(n) = succ(n) by h_trans
end

-- succ(n) + m = succ(n + m)  (successor distributes over left operand).
-- Needed as a lemma for add_comm.
theorem succ_add : for all n : Nat, for all m : Nat, succ(n) + m = succ(n + m)
proof
  take n : Nat
  induction result on m : succ(n) + m = succ(n + m)
    base:
      -- succ(n) + 0 = succ(n) = succ(n + 0)
      have saz  : succ(n) + 0 = succ(n) by add_zero at succ(n)
      have naz  : n + 0 = n by add_zero at n
      have h_rn : succ(n) = succ(n) by refl
      have h_cn  : succ(n + 0) = succ(n) by eq_subst naz and h_rn
      have h_scn : succ(n) = succ(n + 0) by symm h_cn
      have h_sn0 : succ(n) + 0 = succ(n + 0) by trans saz and h_scn
      then succ(n) + 0 = succ(n + 0) by h_sn0
    inductive:
      -- IH: ih : succ(n) + m = succ(n + m)
      -- Goal: succ(n) + succ(m) = succ(n + succ(m))
      -- add_succ internal bound vars 'n', 'm'; after at succ(n): ∀ m, succ(n)+succ(m)=succ(succ(n)+m)
      have ss1 : for all m : Nat, succ(n) + succ(m) = succ(succ(n) + m)
                 by add_succ at succ(n)
      have ss2 : succ(n) + succ(m) = succ(succ(n) + m) by ss1 at m
      have h_rsn : succ(succ(n + m)) = succ(succ(n + m)) by refl
      have h_csn : succ(succ(n) + m) = succ(succ(n + m)) by eq_subst ih and h_rsn
      -- n + succ(m) = succ(n + m)  by add_succ; after at n: ∀ m, n+succ(m)=succ(n+m)
      have ns1 : for all m : Nat, n + succ(m) = succ(n + m) by add_succ at n
      have ns2 : n + succ(m) = succ(n + m) by ns1 at m
      have h_rnm : succ(succ(n + m)) = succ(succ(n + m)) by refl
      have h_rhs : succ(n + succ(m)) = succ(succ(n + m)) by eq_subst ns2 and h_rnm
      have lhs_eq : succ(n) + succ(m) = succ(succ(n + m)) by trans ss2 and h_csn
      have h_sym  : succ(succ(n + m)) = succ(n + succ(m)) by symm h_rhs
      have h_goal : succ(n) + succ(m) = succ(n + succ(m)) by trans lhs_eq and h_sym
      then succ(n) + succ(m) = succ(n + succ(m)) by h_goal
end

-- a + b = b + a  (commutativity of addition).
-- Bound vars 'a','b' avoid capture with add_succ/succ_add internal vars 'n','m'.
-- take a first, then induction on b, so auto-conclusion is ∀ a, ∀ b, a + b = b + a.
theorem add_comm : for all a : Nat, for all b : Nat, a + b = b + a
proof
  take a : Nat
  induction result on b : a + b = b + a
    base:
      -- a + 0 = a = 0 + a
      have az : a + 0 = a by add_zero at a
      have za : 0 + a = a by zero_add at a
      have h_sym : a = 0 + a by symm za
      have h_goal : a + 0 = 0 + a by trans az and h_sym
      then a + 0 = 0 + a by h_goal
    inductive:
      -- IH: ih : a + b = b + a
      -- Goal: a + succ(b) = succ(b) + a
      -- add_succ at a → ∀ m, a + succ(m) = succ(a + m)  [bound var 'm' ≠ free 'b']
      -- at b → a + succ(b) = succ(a + b)
      have as1 : for all m : Nat, a + succ(m) = succ(a + m) by add_succ at a
      have as2 : a + succ(b) = succ(a + b) by as1 at b
      -- succ(a + b) = succ(b + a)  by congruence with IH
      have h_rba : succ(b + a) = succ(b + a) by refl
      have h_cba : succ(a + b) = succ(b + a) by eq_subst ih and h_rba
      -- succ_add at b → ∀ m, succ(b) + m = succ(b + m)  [bound var 'm' ≠ free 'a']
      -- at a → succ(b) + a = succ(b + a)
      have sb1 : for all m : Nat, succ(b) + m = succ(b + m) by succ_add at b
      have sb2 : succ(b) + a = succ(b + a) by sb1 at a
      have h_sym2 : succ(b + a) = succ(b) + a by symm sb2
      -- Chain: a+succ(b) = succ(a+b) = succ(b+a) = succ(b)+a
      have h1 : a + succ(b) = succ(b + a) by trans as2 and h_cba
      have h2 : a + succ(b) = succ(b) + a by trans h1 and h_sym2
      then a + succ(b) = succ(b) + a by h2
end

-- (a + b) + c = a + (b + c)  (associativity of addition).
-- Bound vars 'a','b','c' avoid capture with add_succ internal vars 'n','m'.
-- take a, take b, then induction on c, so auto-conclusion is ∀ a, ∀ b, ∀ c, ...
theorem add_assoc : for all a : Nat, for all b : Nat, for all c : Nat,
                      (a + b) + c = a + (b + c)
proof
  take a : Nat
  take b : Nat
  induction result on c : (a + b) + c = a + (b + c)
    base:
      -- (a+b)+0 = a+b  and  a+(b+0) = a+b
      have lz : (a + b) + 0 = a + b by add_zero at (a + b)
      have rz : b + 0 = b by add_zero at b
      -- a + (b + 0) = a + b  by congruence with rz
      have h_rab : a + b = a + b by refl
      have h_conj : a + (b + 0) = a + b by eq_subst rz and h_rab
      have h_sym : a + b = a + (b + 0) by symm h_conj
      have h_goal : (a + b) + 0 = a + (b + 0) by trans lz and h_sym
      then (a + b) + 0 = a + (b + 0) by h_goal
    inductive:
      -- IH: ih : (a+b)+c = a+(b+c)
      -- Goal: (a+b)+succ(c) = a+(b+succ(c))
      -- Step 1: (a+b)+succ(c) = succ((a+b)+c)  by add_succ at (a+b) at c
      have ls1 : for all m : Nat, (a + b) + succ(m) = succ((a + b) + m)
                 by add_succ at (a + b)
      have ls2 : (a + b) + succ(c) = succ((a + b) + c) by ls1 at c
      -- Step 2: succ((a+b)+c) = succ(a+(b+c))  by congruence with IH
      have h_rabc : succ(a + (b + c)) = succ(a + (b + c)) by refl
      have h_cong : succ((a + b) + c) = succ(a + (b + c)) by eq_subst ih and h_rabc
      -- Step 3: b+succ(c) = succ(b+c)  by add_succ at b at c
      have bs1 : for all m : Nat, b + succ(m) = succ(b + m) by add_succ at b
      have bs2 : b + succ(c) = succ(b + c) by bs1 at c
      -- Step 4: a+succ(b+c) = succ(a+(b+c))  by add_succ at a at (b+c)
      have as1 : for all m : Nat, a + succ(m) = succ(a + m) by add_succ at a
      have as2 : a + succ(b + c) = succ(a + (b + c)) by as1 at (b + c)
      -- Step 5: a+(b+succ(c)) = a+succ(b+c)  by congruence with bs2
      have h_rabs : a + succ(b + c) = a + succ(b + c) by refl
      have h_rhs  : a + (b + succ(c)) = a + succ(b + c) by eq_subst bs2 and h_rabs
      -- Step 6: chain
      have h1 : (a + b) + succ(c) = succ(a + (b + c)) by trans ls2 and h_cong
      have as2_sym : succ(a + (b + c)) = a + succ(b + c) by symm as2
      have h2 : (a + b) + succ(c) = a + succ(b + c) by trans h1 and as2_sym
      have h_rhs_sym : a + succ(b + c) = a + (b + succ(c)) by symm h_rhs
      have h3 : (a + b) + succ(c) = a + (b + succ(c)) by trans h2 and h_rhs_sym
      then (a + b) + succ(c) = a + (b + succ(c)) by h3
end

-- 0 * a = 0  (zero is a left zero for multiplication).
-- mul_zero (right: n * 0 = 0) is in nat.forall; this direction requires induction.
theorem mul_zero_left : for all a : Nat, 0 * a = 0
proof
  induction result on a : 0 * a = 0
    base:
      have mz : 0 * 0 = 0 by mul_zero at 0
      then 0 * 0 = 0 by mz
    inductive:
      -- IH: ih : 0 * a = 0,  Goal: 0 * succ(a) = 0
      -- mul_succ at 0 → ∀ m, 0*succ(m) = 0*m + 0; bound 'm' ≠ free 'a'
      have ms1 : for all m : Nat, 0 * succ(m) = 0 * m + 0 by mul_succ at 0
      have ms2 : 0 * succ(a) = 0 * a + 0 by ms1 at a
      have az  : 0 * a + 0 = 0 * a by add_zero at (0 * a)
      have h1  : 0 * succ(a) = 0 * a by trans ms2 and az
      have h2  : 0 * succ(a) = 0 by trans h1 and ih
      then 0 * succ(a) = 0 by h2
end

-- succ(p) * q = p * q + q  (left-successor law for multiplication).
-- Needed as a lemma for mul_comm.
-- Bound vars 'p','q' avoid capture with add_assoc internal vars 'a','b','c'.
theorem mul_succ_left : for all p : Nat, for all q : Nat, succ(p) * q = p * q + q
proof
  take p : Nat
  induction result on q : succ(p) * q = p * q + q
    base:
      -- succ(p)*0 = 0 = p*0+0
      have sl  : succ(p) * 0 = 0 by mul_zero at succ(p)
      have al  : p * 0 = 0 by mul_zero at p
      have azl : p * 0 + 0 = p * 0 by add_zero at (p * 0)
      have rz  : p * 0 + 0 = 0 by trans azl and al
      have rz_sym : 0 = p * 0 + 0 by symm rz
      have h_goal : succ(p) * 0 = p * 0 + 0 by trans sl and rz_sym
      then succ(p) * 0 = p * 0 + 0 by h_goal
    inductive:
      -- IH: ih : succ(p)*q = p*q+q,  Goal: succ(p)*succ(q) = p*succ(q)+succ(q)
      -- Step 1: succ(p)*succ(q) = succ(p)*q + succ(p)
      -- mul_succ at succ(p): ∀ m, succ(p)*succ(m) = succ(p)*m + succ(p); bound 'm' ≠ 'p','q'
      have ss1 : for all m : Nat, succ(p) * succ(m) = succ(p) * m + succ(p)
                 by mul_succ at succ(p)
      have ss2 : succ(p) * succ(q) = succ(p) * q + succ(p) by ss1 at q
      -- Step 2: succ(p)*q + succ(p) = (p*q+q) + succ(p)  by congruence with IH
      have h_r2 : (p * q + q) + succ(p) = (p * q + q) + succ(p) by refl
      have h_c2 : succ(p) * q + succ(p) = (p * q + q) + succ(p)
                  by eq_subst ih and h_r2
      -- Step 3: p*succ(q) = p*q + p  by mul_succ at p; bound 'm' ≠ 'p','q'
      have ms1 : for all m : Nat, p * succ(m) = p * m + p by mul_succ at p
      have ms2 : p * succ(q) = p * q + p by ms1 at q
      -- Step 4: (p*q+q)+succ(p) = (p*q+p)+succ(q)
      -- (a) add_assoc at (p*q): ∀ b, ∀ c, (p*q+b)+c = p*q+(b+c)
      --     bound 'b','c' are add_assoc's vars; p*q contains only 'p','q' — no capture.
      have aa0 : for all b : Nat, for all c : Nat, (p * q + b) + c = p * q + (b + c)
                 by add_assoc at (p * q)
      -- (b) aa0 at q: substitute bound 'b' → free 'q'; p*q has no 'b' → no capture
      have aa1 : for all c : Nat, (p * q + q) + c = p * q + (q + c)
                 by aa0 at q
      -- (c) aa1 at succ(p): (p*q+q)+succ(p) = p*q+(q+succ(p))
      have al_sp : (p * q + q) + succ(p) = p * q + (q + succ(p))
                   by aa1 at succ(p)
      -- (d) q+succ(p) = p+succ(q)  via add_succ and add_comm
      -- add_succ at q: ∀ m, q+succ(m) = succ(q+m); bound 'm' ≠ 'p'
      have qsp0 : for all m : Nat, q + succ(m) = succ(q + m) by add_succ at q
      have qsp  : q + succ(p) = succ(q + p) by qsp0 at p
      -- add_comm at q: ∀ b, q+b = b+q; bound 'b' ≠ 'p'
      have qpc0 : for all b : Nat, q + b = b + q by add_comm at q
      have qpc  : q + p = p + q by qpc0 at p
      -- succ(q+p) = succ(p+q) by congruence
      have h_rpq : succ(p + q) = succ(p + q) by refl
      have h_sqp : succ(q + p) = succ(p + q) by eq_subst qpc and h_rpq
      -- add_succ at p: ∀ m, p+succ(m) = succ(p+m); bound 'm' ≠ 'q'
      have psq0 : for all m : Nat, p + succ(m) = succ(p + m) by add_succ at p
      have psq  : p + succ(q) = succ(p + q) by psq0 at q
      have psq_sym : succ(p + q) = p + succ(q) by symm psq
      -- Chain: q+succ(p) = succ(q+p) = succ(p+q) = p+succ(q)
      have swap1 : q + succ(p) = succ(p + q) by trans qsp and h_sqp
      have swap  : q + succ(p) = p + succ(q) by trans swap1 and psq_sym
      -- (e) p*q+(q+succ(p)) = p*q+(p+succ(q)) by congruence with swap
      have h_rpsq : p * q + (p + succ(q)) = p * q + (p + succ(q)) by refl
      have mid : p * q + (q + succ(p)) = p * q + (p + succ(q))
                 by eq_subst swap and h_rpsq
      -- (f) aa0 at p: substitute bound 'b' → free 'p'; p*q has no 'b' → no capture
      have ar1 : for all c : Nat, (p * q + p) + c = p * q + (p + c)
                 by aa0 at p
      -- (g) ar1 at succ(q): (p*q+p)+succ(q) = p*q+(p+succ(q))
      have ar_sq : (p * q + p) + succ(q) = p * q + (p + succ(q))
                   by ar1 at succ(q)
      have ar_sym : p * q + (p + succ(q)) = (p * q + p) + succ(q) by symm ar_sq
      -- (h) Chain: (p*q+q)+succ(p) = p*q+(q+succ(p)) = p*q+(p+succ(q)) = (p*q+p)+succ(q)
      have key1 : (p * q + q) + succ(p) = p * q + (p + succ(q))
                  by trans al_sp and mid
      have key2 : (p * q + q) + succ(p) = (p * q + p) + succ(q)
                  by trans key1 and ar_sym
      -- Step 5: (p*q+p)+succ(q) = p*succ(q)+succ(q) by congruence with symm ms2
      have ms2_sym : p * q + p = p * succ(q) by symm ms2
      have h_rms : p * succ(q) + succ(q) = p * succ(q) + succ(q) by refl
      have key3 : (p * q + p) + succ(q) = p * succ(q) + succ(q)
                  by eq_subst ms2_sym and h_rms
      have key4 : (p * q + q) + succ(p) = p * succ(q) + succ(q)
                  by trans key2 and key3
      -- Step 6: succ(p)*succ(q) = (p*q+q)+succ(p) = p*succ(q)+succ(q)
      have chain1 : succ(p) * succ(q) = (p * q + q) + succ(p)
                    by trans ss2 and h_c2
      have final  : succ(p) * succ(q) = p * succ(q) + succ(q)
                    by trans chain1 and key4
      then succ(p) * succ(q) = p * succ(q) + succ(q) by final
end

-- a * b = b * a  (commutativity of multiplication).
-- Relies on mul_succ_left (stated with bound vars 'p','q') and mul_zero_left.
theorem mul_comm : for all a : Nat, for all b : Nat, a * b = b * a
proof
  take a : Nat
  induction result on b : a * b = b * a
    base:
      -- a * 0 = 0 = 0 * a
      have az : a * 0 = 0 by mul_zero at a
      have za : 0 * a = 0 by mul_zero_left at a
      have za_sym : 0 = 0 * a by symm za
      have h_goal : a * 0 = 0 * a by trans az and za_sym
      then a * 0 = 0 * a by h_goal
    inductive:
      -- IH: ih : a * b = b * a,  Goal: a * succ(b) = succ(b) * a
      -- a * succ(b) = a * b + a  by mul_succ at a; bound 'm' ≠ 'b'
      have ms1 : for all m : Nat, a * succ(m) = a * m + a by mul_succ at a
      have ms2 : a * succ(b) = a * b + a by ms1 at b
      -- succ(b) * a = b * a + a  by mul_succ_left at b; bound 'q' ≠ 'a'
      have sl1 : for all q : Nat, succ(b) * q = b * q + q by mul_succ_left at b
      have sl2 : succ(b) * a = b * a + a by sl1 at a
      -- a * b + a = b * a + a  by congruence with IH
      have h_rba : b * a + a = b * a + a by refl
      have h_cba : a * b + a = b * a + a by eq_subst ih and h_rba
      -- succ(b) * a = b * a + a  and  a * b + a = b * a + a
      -- → a * succ(b) = succ(b) * a
      have sl2_sym : b * a + a = succ(b) * a by symm sl2
      have h1 : a * succ(b) = b * a + a by trans ms2 and h_cba
      have h2 : a * succ(b) = succ(b) * a by trans h1 and sl2_sym
      then a * succ(b) = succ(b) * a by h2
end

-- n * 1 = n  (right identity of multiplication).
theorem mul_one_right : for all n : Nat, n * 1 = n
proof
  take n : Nat
  -- Bridge: 1 = succ(0) in the AST (ExprLit vs ExprCall)
  -- eq_subst one_eq_succ_zero: P(x) = n*x = n*succ(0), P(1) = n*1 = n*succ(0)
  have h_one : n * succ(0) = n * succ(0) by refl
  have one_eq : n * 1 = n * succ(0) by eq_subst one_eq_succ_zero and h_one
  -- n * succ(0) = n * 0 + n  by mul_succ at n at 0
  have ms1 : for all m : Nat, n * succ(m) = n * m + n by mul_succ at n
  have ms2 : n * succ(0) = n * 0 + n by ms1 at 0
  -- n * 0 + n = n
  have nz  : n * 0 = 0 by mul_zero at n
  have hr  : 0 + n = n by zero_add at n
  have h1  : n * 0 + n = n by eq_subst nz and hr
  -- chain: n*1 = n*succ(0) = n*0+n = n
  have h2  : n * succ(0) = n by trans ms2 and h1
  have h3  : n * 1 = n by trans one_eq and h2
  then n * 1 = n by h3
end

-- 1 * n = n  (left identity of multiplication).
theorem mul_one_left : for all n : Nat, 1 * n = n
proof
  take n : Nat
  -- 1 * n = n * 1  by mul_comm; n * 1 = n  by mul_one_right
  -- mul_comm at 1: ∀ b, 1*b = b*1; bound 'b' ≠ free 'n'
  have mc0 : for all b : Nat, 1 * b = b * 1 by mul_comm at 1
  have mc1 : 1 * n = n * 1 by mc0 at n
  have mr  : n * 1 = n by mul_one_right at n
  have h   : 1 * n = n by trans mc1 and mr
  then 1 * n = n by h
end

-- p * (q + r) = p*q + p*r  (left distributivity of multiplication over addition).
-- Bound vars 'p','q','r' avoid capture with add_assoc internal vars 'a','b','c'.
theorem mul_distrib_left : for all p : Nat, for all q : Nat, for all r : Nat,
                             p * (q + r) = p * q + p * r
proof
  take p : Nat
  take q : Nat
  induction result on r : p * (q + r) = p * q + p * r
    base:
      -- p*(q+0) = p*q = p*q + p*0 = p*q + 0 = p*q
      have qz  : q + 0 = q by add_zero at q
      have pqz : p * q = p * q by refl
      -- eq_subst qz: p*(q+0) = p*q by congruence
      have lhs : p * (q + 0) = p * q by eq_subst qz and pqz
      have rz  : p * 0 = 0 by mul_zero at p
      have pqr : p * q + 0 = p * q by add_zero at (p * q)
      have rhs : p * q + p * 0 = p * q by eq_subst rz and pqr
      -- p*(q+0) = p*q = p*q + p*0
      have rhs_sym : p * q = p * q + p * 0 by symm rhs
      have h_goal : p * (q + 0) = p * q + p * 0 by trans lhs and rhs_sym
      then p * (q + 0) = p * q + p * 0 by h_goal
    inductive:
      -- IH: ih : p*(q+r) = p*q + p*r,  Goal: p*(q+succ(r)) = p*q + p*succ(r)
      -- Step 1: q+succ(r) = succ(q+r)  by add_succ at q (bound 'm' ≠ 'p','q','r')
      have qs0 : for all m : Nat, q + succ(m) = succ(q + m) by add_succ at q
      have qs1 : q + succ(r) = succ(q + r) by qs0 at r
      -- Step 2: p*(q+succ(r)) = p*succ(q+r) by congruence with qs1
      have h_rpqr : p * succ(q + r) = p * succ(q + r) by refl
      have lhs_eq : p * (q + succ(r)) = p * succ(q + r) by eq_subst qs1 and h_rpqr
      -- Step 3: p*succ(q+r) = p*(q+r) + p  by mul_succ at p (bound 'm' ≠ 'p','q','r')
      have msp0 : for all m : Nat, p * succ(m) = p * m + p by mul_succ at p
      have msp1 : p * succ(q + r) = p * (q + r) + p by msp0 at (q + r)
      -- Step 4: p*(q+r) + p = (p*q + p*r) + p  by congruence with IH
      have h_rhs : (p * q + p * r) + p = (p * q + p * r) + p by refl
      have cong  : p * (q + r) + p = (p * q + p * r) + p by eq_subst ih and h_rhs
      -- Step 5: (p*q + p*r) + p = p*q + (p*r + p)
      --   add_assoc at (p*q): ∀ b, ∀ c, (p*q+b)+c = p*q+(b+c)
      --   bound 'b','c' ≠ free 'p','q','r'; p*q has no 'b' or 'c' ✓
      have aa0 : for all b : Nat, for all c : Nat, (p * q + b) + c = p * q + (b + c)
                 by add_assoc at (p * q)
      have aa1 : for all c : Nat, (p * q + p * r) + c = p * q + (p * r + c)
                 by aa0 at (p * r)
      have aa2 : (p * q + p * r) + p = p * q + (p * r + p) by aa1 at p
      -- Step 6: p*r + p = p*succ(r)  by symm mul_succ at p at r
      have mrs0 : for all m : Nat, p * succ(m) = p * m + p by mul_succ at p
      have mrs1 : p * succ(r) = p * r + p by mrs0 at r
      have mrs_sym : p * r + p = p * succ(r) by symm mrs1
      -- Step 7: p*q + (p*r + p) = p*q + p*succ(r)  by congruence
      have h_rpr : p * q + p * succ(r) = p * q + p * succ(r) by refl
      have rhs_eq : p * q + (p * r + p) = p * q + p * succ(r)
                    by eq_subst mrs_sym and h_rpr
      -- Step 8: chain:
      --   p*(q+succ(r)) = p*succ(q+r)                    [lhs_eq]
      --   = p*(q+r) + p                                   [msp1]
      --   = (p*q + p*r) + p                               [cong]
      --   = p*q + (p*r + p)                               [aa2]
      --   = p*q + p*succ(r)                               [rhs_eq]
      have chain1 : p * (q + succ(r)) = p * (q + r) + p
                    by trans lhs_eq and msp1
      have chain2 : p * (q + succ(r)) = (p * q + p * r) + p
                    by trans chain1 and cong
      have chain3 : p * (q + succ(r)) = p * q + (p * r + p)
                    by trans chain2 and aa2
      have chain4 : p * (q + succ(r)) = p * q + p * succ(r)
                    by trans chain3 and rhs_eq
      then p * (q + succ(r)) = p * q + p * succ(r) by chain4
end

-- (s + t) * u = s*u + t*u  (right distributivity of multiplication over addition).
-- Bound vars 's','t','u' avoid capture with mul_distrib_left internal vars 'p','q','r'.
theorem mul_distrib_right : for all s : Nat, for all t : Nat, for all u : Nat,
                              (s + t) * u = s * u + t * u
proof
  take s : Nat
  take t : Nat
  take u : Nat
  -- (s+t)*u = u*(s+t)  by mul_comm at (s+t) at u
  have mc0 : for all b : Nat, (s + t) * b = b * (s + t) by mul_comm at (s + t)
  have mc1 : (s + t) * u = u * (s + t) by mc0 at u
  -- u*(s+t) = u*s + u*t  by mul_distrib_left at u at s at t
  -- mul_distrib_left has bound 'p','q','r'; after at u: ∀ q, ∀ r, u*(q+r)=u*q+u*r
  -- at s: ∀ r, u*(s+r)=u*s+u*r; at t: u*(s+t)=u*s+u*t — no capture ✓
  have dl0 : for all q : Nat, for all r : Nat, u * (q + r) = u * q + u * r
             by mul_distrib_left at u
  have dl1 : for all r : Nat, u * (s + r) = u * s + u * r by dl0 at s
  have dl2 : u * (s + t) = u * s + u * t by dl1 at t
  -- u*s = s*u  and  u*t = t*u  by mul_comm
  have cs0 : for all b : Nat, u * b = b * u by mul_comm at u
  have cs1 : u * s = s * u by cs0 at s
  have ct1 : u * t = t * u by cs0 at t
  -- u*s + u*t = s*u + t*u  by two congruences
  have h_rsu : s * u + u * t = s * u + u * t by refl
  have h_su  : u * s + u * t = s * u + u * t by eq_subst cs1 and h_rsu
  have h_rtu : s * u + t * u = s * u + t * u by refl
  have h_tu  : s * u + u * t = s * u + t * u by eq_subst ct1 and h_rtu
  have h_step1 : u * (s + t) = s * u + u * t by trans dl2 and h_su
  have h_sum   : u * (s + t) = s * u + t * u by trans h_step1 and h_tu
  then (s + t) * u = s * u + t * u by trans mc1 and h_sum
end

-- (x * y) * z = x * (y * z)  (associativity of multiplication).
-- Bound vars 'x','y','z' avoid capture with mul_distrib_left internal vars 'p','q','r'.
theorem mul_assoc : for all x : Nat, for all y : Nat, for all z : Nat,
                     (x * y) * z = x * (y * z)
proof
  take x : Nat
  take y : Nat
  induction result on z : (x * y) * z = x * (y * z)
    base:
      -- (x*y)*0 = 0 = x*0 = x*(y*0)
      have lz : (x * y) * 0 = 0 by mul_zero at (x * y)
      have yz : y * 0 = 0 by mul_zero at y
      have h_r0 : x * 0 = x * 0 by refl
      -- x*(y*0) = x*0  by congruence with yz
      have h_xy0 : x * (y * 0) = x * 0 by eq_subst yz and h_r0
      have xz : x * 0 = 0 by mul_zero at x
      have h_rhs     : x * (y * 0) = 0 by trans h_xy0 and xz
      have h_rhs_sym : 0 = x * (y * 0) by symm h_rhs
      have h_goal    : (x * y) * 0 = x * (y * 0) by trans lz and h_rhs_sym
      then (x * y) * 0 = x * (y * 0) by h_goal
    inductive:
      -- IH: ih : (x*y)*z = x*(y*z),  Goal: (x*y)*succ(z) = x*(y*succ(z))
      -- Step 1: (x*y)*succ(z) = (x*y)*z + x*y
      -- mul_succ at (x*y): ∀ m, (x*y)*succ(m) = (x*y)*m + x*y; bound 'm' ≠ 'x','y','z'
      have ms0 : for all m : Nat, (x * y) * succ(m) = (x * y) * m + x * y
                 by mul_succ at (x * y)
      have ms1 : (x * y) * succ(z) = (x * y) * z + x * y by ms0 at z
      -- Step 2: (x*y)*z + x*y = x*(y*z) + x*y  by congruence with IH
      have h_r2 : x * (y * z) + x * y = x * (y * z) + x * y by refl
      have cong : (x * y) * z + x * y = x * (y * z) + x * y by eq_subst ih and h_r2
      -- Step 3: y*succ(z) = y*z + y  by mul_succ at y at z
      have ys0 : for all m : Nat, y * succ(m) = y * m + y by mul_succ at y
      have ys1 : y * succ(z) = y * z + y by ys0 at z
      -- Step 4: x*(y*succ(z)) = x*(y*z + y)  by congruence with ys1
      have h_r3 : x * (y * z + y) = x * (y * z + y) by refl
      have rhs_eq : x * (y * succ(z)) = x * (y * z + y) by eq_subst ys1 and h_r3
      -- Step 5: x*(y*z + y) = x*(y*z) + x*y  by mul_distrib_left at x at (y*z) at y
      -- mul_distrib_left has bound 'p','q','r'; at x: ∀ q, ∀ r, x*(q+r)=x*q+x*r
      -- at (y*z): ∀ r, x*(y*z+r)=x*(y*z)+x*r; at y: x*(y*z+y)=x*(y*z)+x*y
      -- no capture: p→x (free x has no 'q' or 'r'); q→y*z (has y,z not q or r); r→y ✓
      have dl0 : for all q : Nat, for all r : Nat, x * (q + r) = x * q + x * r
                 by mul_distrib_left at x
      have dl1 : for all r : Nat, x * (y * z + r) = x * (y * z) + x * r
                 by dl0 at (y * z)
      have dl2 : x * (y * z + y) = x * (y * z) + x * y by dl1 at y
      -- Step 6: x*(y*succ(z)) = x*(y*z) + x*y
      have rhs_simp : x * (y * succ(z)) = x * (y * z) + x * y by trans rhs_eq and dl2
      -- Step 7: chain:
      --   (x*y)*succ(z) = (x*y)*z + x*y = x*(y*z) + x*y = x*(y*succ(z))
      have chain1 : (x * y) * succ(z) = x * (y * z) + x * y by trans ms1 and cong
      have rhs_sym : x * (y * z) + x * y = x * (y * succ(z)) by symm rhs_simp
      have chain2 : (x * y) * succ(z) = x * (y * succ(z)) by trans chain1 and rhs_sym
      then (x * y) * succ(z) = x * (y * succ(z)) by chain2
end

-- a ≤ b ∧ b ≤ a → a = b  (antisymmetry of ≤).
theorem le_antisymm : for all p : Nat, for all q : Nat,
                       p <= q implies q <= p implies p = q
proof
  take p : Nat
  take q : Nat
  suppose h1 : p <= q
  suppose h2 : q <= p
  then p = q by omega
end

-- a + b ≤ a + c → b ≤ c  (left cancellation for ≤).
theorem add_le_cancel_left : for all p : Nat, for all q : Nat, for all r : Nat,
                              p + q <= p + r implies q <= r
proof
  take p : Nat
  take q : Nat
  take r : Nat
  suppose h : p + q <= p + r
  then q <= r by omega
end

-- b + a ≤ c + a → b ≤ c  (right cancellation for ≤).
theorem add_le_cancel_right : for all p : Nat, for all q : Nat, for all r : Nat,
                               q + p <= r + p implies q <= r
proof
  take p : Nat
  take q : Nat
  take r : Nat
  suppose h : q + p <= r + p
  then q <= r by omega
end

-- a + b = a + c → b = c  (left cancellation of addition).
-- Proof: split equality into ≤ and ≥; cancel each via add_le_cancel_left; antisymm.
-- add_le_cancel_left uses bound vars p,q,r so 'at a at b at c' avoids capture.
theorem add_left_cancel : for all a : Nat, for all b : Nat, for all c : Nat,
                           a + b = a + c implies b = c
proof
  take a : Nat
  take b : Nat
  take c : Nat
  suppose h : a + b = a + c
  have h_le : a + b <= a + c by omega
  have h_ge : a + c <= a + b by omega
  -- Forward: a+b ≤ a+c → b ≤ c.  add_le_cancel_left at a → ∀ q r, a+q ≤ a+r → q ≤ r
  have alc0 : for all q : Nat, for all r : Nat, a + q <= a + r implies q <= r
              by add_le_cancel_left at a
  have alc1 : for all r : Nat, a + b <= a + r implies b <= r by alc0 at b
  have alc2 : a + b <= a + c implies b <= c by alc1 at c
  have bc_le : b <= c by alc2 and h_le
  -- Reverse: a+c ≤ a+b → c ≤ b.  alc0 at c → ∀ r, a+c ≤ a+r → c ≤ r
  have alc3 : for all r : Nat, a + c <= a + r implies c <= r by alc0 at c
  have alc4 : a + c <= a + b implies c <= b by alc3 at b
  have cb_le : c <= b by alc4 and h_ge
  -- Antisymmetry: le_antisymm at b → ∀ q, b ≤ q → q ≤ b → b = q
  have las0 : for all q : Nat, b <= q implies q <= b implies b = q
              by le_antisymm at b
  have las1 : b <= c implies c <= b implies b = c by las0 at c
  have las2 : c <= b implies b = c by las1 and bc_le
  then b = c by las2 and cb_le
end

-- b + a = c + a → b = c  (right cancellation of addition).
-- add_le_cancel_right uses bound vars p,q,r where p is the common right addend.
theorem add_right_cancel : for all a : Nat, for all b : Nat, for all c : Nat,
                            b + a = c + a implies b = c
proof
  take a : Nat
  take b : Nat
  take c : Nat
  suppose h : b + a = c + a
  have h_le : b + a <= c + a by omega
  have h_ge : c + a <= b + a by omega
  -- add_le_cancel_right : ∀ p q r, q+p ≤ r+p → q ≤ r.  at a → ∀ q r, q+a ≤ r+a → q ≤ r
  have arc0 : for all q : Nat, for all r : Nat, q + a <= r + a implies q <= r
              by add_le_cancel_right at a
  have arc1 : for all r : Nat, b + a <= r + a implies b <= r by arc0 at b
  have arc2 : b + a <= c + a implies b <= c by arc1 at c
  have bc_le : b <= c by arc2 and h_le
  have arc3 : for all r : Nat, c + a <= r + a implies c <= r by arc0 at c
  have arc4 : c + a <= b + a implies c <= b by arc3 at b
  have cb_le : c <= b by arc4 and h_ge
  have las0 : for all q : Nat, b <= q implies q <= b implies b = q
              by le_antisymm at b
  have las1 : b <= c implies c <= b implies b = c by las0 at c
  have las2 : c <= b implies b = c by las1 and bc_le
  then b = c by las2 and cb_le
end

-- a < b → a + c < b + c  (addition is strictly monotone on the right).
theorem add_lt_add_right : for all a : Nat, for all b : Nat, for all c : Nat,
                            a < b implies a + c < b + c
proof
  take a : Nat
  take b : Nat
  take c : Nat
  suppose h : a < b
  then a + c < b + c by omega
end

-- a < b → c + a < c + b  (addition is strictly monotone on the left).
theorem add_lt_add_left : for all a : Nat, for all b : Nat, for all c : Nat,
                           a < b implies c + a < c + b
proof
  take a : Nat
  take b : Nat
  take c : Nat
  suppose h : a < b
  then c + a < c + b by omega
end

-- a ≤ b → a + c ≤ b + c  (addition is monotone on the right).
theorem add_le_add_right : for all a : Nat, for all b : Nat, for all c : Nat,
                            a <= b implies a + c <= b + c
proof
  take a : Nat
  take b : Nat
  take c : Nat
  suppose h : a <= b
  then a + c <= b + c by omega
end

-- a ≤ b → c + a ≤ c + b  (addition is monotone on the left).
theorem add_le_add_left : for all a : Nat, for all b : Nat, for all c : Nat,
                           a <= b implies c + a <= c + b
proof
  take a : Nat
  take b : Nat
  take c : Nat
  suppose h : a <= b
  then c + a <= c + b by omega
end

-- a ≤ b ∧ c ≤ d → a + c ≤ b + d  (addition preserves ≤ in both arguments).
theorem add_le_add : for all a : Nat, for all b : Nat, for all c : Nat, for all d : Nat,
                     a <= b implies c <= d implies a + c <= b + d
proof
  take a : Nat
  take b : Nat
  take c : Nat
  take d : Nat
  suppose h1 : a <= b
  suppose h2 : c <= d
  then a + c <= b + d by omega
end

-- n < succ(n)  (restatement of the lt_succ axiom as a proved theorem).
theorem lt_succ_self : for all n : Nat, n < succ(n)
proof
  take n : Nat
  then n < succ(n) by lt_succ at n
end

-- a ≤ b → b ≤ c → a ≤ c  (transitivity of ≤).
theorem le_trans : for all p : Nat, for all q : Nat, for all r : Nat,
                   p <= q implies q <= r implies p <= r
proof
  take p : Nat
  take q : Nat
  take r : Nat
  suppose h1 : p <= q
  suppose h2 : q <= r
  then p <= r by omega
end

-- a < b → b < c → a < c  (transitivity of <).
theorem lt_trans : for all p : Nat, for all q : Nat, for all r : Nat,
                   p < q implies q < r implies p < r
proof
  take p : Nat
  take q : Nat
  take r : Nat
  suppose h1 : p < q
  suppose h2 : q < r
  then p < r by omega
end

-- a ≤ b → b < c → a < c  (mixed transitivity).
theorem le_lt_trans : for all p : Nat, for all q : Nat, for all r : Nat,
                      p <= q implies q < r implies p < r
proof
  take p : Nat
  take q : Nat
  take r : Nat
  suppose h1 : p <= q
  suppose h2 : q < r
  then p < r by omega
end

-- a < b → b ≤ c → a < c  (mixed transitivity).
theorem lt_le_trans : for all p : Nat, for all q : Nat, for all r : Nat,
                      p < q implies q <= r implies p < r
proof
  take p : Nat
  take q : Nat
  take r : Nat
  suppose h1 : p < q
  suppose h2 : q <= r
  then p < r by omega
end

-- n ≤ n + m  (a number is no greater than itself plus anything).
-- Proved by induction on m.  lt_succ bound var is 'n'; use fresh name to avoid capture.
theorem le_add_right : for all n : Nat, for all m : Nat, n <= n + m
proof
  take n : Nat
  induction result on m : n <= n + m
    base:
      -- n + 0 = n;  EqSubst [n+0=n, n≤n] ⊢ n≤n+0.
      have h : n + 0 = n by add_zero at n
      have hn : n <= n by omega
      then n <= n + 0 by eq_subst h and hn
    inductive:
      -- IH: ih : n <= n + m.  Goal: n <= n + succ(m).
      -- n + succ(m) = succ(n + m)  (add_succ bound vars: n, m).
      have as0 : for all m : Nat, n + succ(m) = succ(n + m) by add_succ at n
      have as1 : n + succ(m) = succ(n + m) by as0 at m
      -- n + m < succ(n + m)  (lt_succ bound var: n).
      -- Declare result with bound var 'n' to match lt_succ output.
      have ls : n + m < succ(n + m) by lt_succ at (n + m)
      -- n <= n+m (ih) + n+m < succ(n+m) → n < succ(n+m) via le_lt_trans.
      -- le_lt_trans bound vars: p, q, r.  at n → ∀ q r, n≤q → q<r → n<r.
      have llt0 : for all q : Nat, for all r : Nat,
                   n <= q implies q < r implies n < r by le_lt_trans at n
      have llt1 : for all r : Nat,
                   n <= (n + m) implies (n + m) < r implies n < r by llt0 at (n + m)
      -- at succ(n+m): n <= (n+m) → (n+m) < succ(n+m) → n < succ(n+m).
      have llt2 : n <= (n + m) implies (n + m) < succ(n + m) implies n < succ(n + m)
                  by llt1 at succ(n + m)
      -- Apply ih to discharge first premise.
      have llt3 : (n + m) < succ(n + m) implies n < succ(n + m) by llt2 and ih
      -- Apply ls to get n < succ(n + m).
      have n_lt : n < succ(n + m) by llt3 and ls
      -- Rewrite succ(n+m) as n+succ(m): EqSubst [as1, n_lt] ⊢ n < n+succ(m).
      have n_lt2 : n < n + succ(m) by eq_subst as1 and n_lt
      then n <= n + succ(m) by omega
end

-- n ≤ m + n  (symmetric form of le_add_right).
-- Proved by induction on m, mirroring le_add_right.
-- add_succ bound vars: n, m.  After at m: ∀ n, m+succ(n)=succ(m+n) — wrong order.
-- Use add_comm to convert le_add_right result.
theorem le_add_left : for all n : Nat, for all m : Nat, n <= m + n
proof
  take n : Nat
  induction result on m : n <= m + n
    base:
      -- m = 0: n ≤ 0 + n = n by zero_add; n ≤ n by omega; eq_subst gives n ≤ 0+n.
      have h : 0 + n = n by zero_add at n
      have hn : n <= n by omega
      then n <= 0 + n by eq_subst h and hn
    inductive:
      -- IH: ih : n <= m + n.  Goal: n <= succ(m) + n.
      -- succ_add: succ(m) + n = succ(m + n) — need succ_add.
      -- succ_add bound vars: n, m.  After at m: ∀ m, succ(m)+m=succ(m+m) -- capture!
      -- succ_add : ∀ n m, succ(n) + m = succ(n + m).  at m → ∀ m, succ(m)+m=succ(m+m).
      -- Use fresh outer name: at m gives ∀ m, succ(m)+m ... collision.
      -- succ_add at m at n: ∀ m (bound), succ(m)+m... still collides.
      -- Best: use succ(m) as witness for the outer var of succ_add.
      -- succ_add : ∀ n m, succ(n)+m = succ(n+m).  at m → ∀ m, succ(m)+m=succ(m+m). Degenerate.
      -- Workaround: use add_comm + le_add_right result directly.
      -- succ(m) + n = n + succ(m) by add_comm.
      -- n + succ(m) = succ(n + m) by add_succ.
      -- n <= n + succ(m) by le_add_right (proved above) instantiated at n at succ(m).
      -- Wait: le_add_right is in scope now. But n and m are local; le_add_right uses n, m.
      -- le_add_right : ∀ n m, n≤n+m.  Instantiate at n: ∀ m, n≤n+m (bound var m).
      -- at succ(m): n ≤ n + succ(m).
      have lar0 : for all m : Nat, n <= n + m by le_add_right at n
      have lar1 : n <= n + succ(m) by lar0 at succ(m)
      -- n + succ(m) = succ(n + m) by add_succ at n at m.
      have as0 : for all m : Nat, n + succ(m) = succ(n + m) by add_succ at n
      have as1 : n + succ(m) = succ(n + m) by as0 at m
      -- succ(m) + n = n + succ(m) by add_comm.
      -- add_comm : ∀ n m, n+m = m+n.  at succ(m): ∀ m, succ(m)+m = m+succ(m). Captures m!
      -- Use add_comm at n: ∀ m, n+m=m+n.  at succ(m): n+succ(m) = succ(m)+n.
      -- add_comm : ∀ a b, a+b=b+a.  at n → ∀ b, n+b=b+n (bound var 'b').
      have ac0 : for all b : Nat, n + b = b + n by add_comm at n
      have ac1 : n + succ(m) = succ(m) + n by ac0 at succ(m)
      -- symm ac1 : succ(m)+n = n+succ(m).
      -- EqSubst [succ(m)+n = n+succ(m), n≤n+succ(m)] ⊢ n≤succ(m)+n.
      have ac2 : succ(m) + n = n + succ(m) by symm ac1
      then n <= succ(m) + n by eq_subst ac2 and lar1
end

-- n + 1 = succ(n)  (bridges between arithmetic +1 and the succ constructor).
-- Proof: add_succ gives n+succ(0)=succ(n+0); add_zero gives n+0=n; combine via
-- eq_subst to get n+succ(0)=succ(n); then one_eq_succ_zero rewrites 1→succ(0).
theorem succ_eq_add_one : for all n : Nat, n + 1 = succ(n)
proof
  take n : Nat
  have as0 : for all m : Nat, n + succ(m) = succ(n + m) by add_succ at n
  have as1 : n + succ(0) = succ(n + 0) by as0 at 0
  have az : n + 0 = n by add_zero at n
  have refl_succ : succ(n) = succ(n) by refl
  have succ_n0_eq : succ(n + 0) = succ(n) by eq_subst az and refl_succ
  have succ_n0_sym : succ(n) = succ(n + 0) by symm succ_n0_eq
  have h1 : n + succ(0) = succ(n) by eq_subst succ_n0_sym and as1
  then n + 1 = succ(n) by eq_subst one_eq_succ_zero and h1
end

-- 0 < succ(n)  (every successor is positive).
-- Proof: 0 ≤ n (nat_le_zero), n < succ(n) (lt_succ), so 0 < succ(n) by le_lt_trans.
theorem succ_pos : for all n : Nat, 0 < succ(n)
proof
  take n : Nat
  have h_le : 0 <= n by nat_le_zero at n
  have h_lt : n < succ(n) by lt_succ at n
  have llt0 : for all q : Nat, for all r : Nat, 0 <= q implies q < r implies 0 < r
              by le_lt_trans at 0
  have llt1 : for all r : Nat, 0 <= n implies n < r implies 0 < r by llt0 at n
  have llt2 : 0 <= n implies n < succ(n) implies 0 < succ(n) by llt1 at succ(n)
  have llt3 : n < succ(n) implies 0 < succ(n) by llt2 and h_le
  then 0 < succ(n) by llt3 and h_lt
end

-- ¬(n < n)  (strict inequality is irreflexive).
-- The sub-proof (no taken vars) allows NotIntro without conclusion-wrapper issues.
theorem lt_irrefl : for all n : Nat, not (n < n)
proof
  take n : Nat
  have result : not (n < n)
    proof
      suppose h : n < n
      have f : false by omega
      then not (n < n) by h and f
    end
  then not (n < n) by result
end

-- ¬(n < 0)  (no natural number is less than zero).
-- nat_le_zero gives 0 ≤ n; combined with n < 0 this is contradictory.
theorem not_lt_zero : for all n : Nat, not (n < 0)
proof
  take n : Nat
  have result : not (n < 0)
    proof
      suppose h : n < 0
      have h_le : 0 <= n by nat_le_zero at n
      have f : false by omega
      then not (n < 0) by h and f
    end
  then not (n < 0) by result
end

-- n < m → succ(n) ≤ m  (strict inequality implies successor is still bounded).
-- Proved by induction on m.  P(m) = n < m → succ(n) ≤ m, so each arm concludes
-- an implication; sub-proof blocks build the implication via suppose/then.
-- Base: n < 0 contradicts nat_le_zero, omega handles it.
-- Inductive: le_of_lt_succ gives n ≤ m; succ_eq_add_one + add_le_add_right lift
-- n ≤ m to n+1 ≤ m+1; eq_subst then converts n+1 = succ(n), m+1 = succ(m).
theorem lt_succ_le : for all n : Nat, for all m : Nat, n < m implies succ(n) <= m
proof
  take n : Nat
  induction result on m : n < m implies succ(n) <= m
    base:
      suppose h : n < 0
      have nle : 0 <= n by nat_le_zero at n
      have concl : succ(n) <= 0 by omega
      have vac : n < 0 implies succ(n) <= 0 by h and concl
      then n < 0 implies succ(n) <= 0 by vac
    inductive:
      suppose h : n < succ(m)
      have lofs0 : for all m : Nat, n < succ(m) implies n <= m by le_of_lt_succ at n
      have lofs1 : n < succ(m) implies n <= m by lofs0 at m
      have hle : n <= m by lofs1 and h
      have sn_eq : n + 1 = succ(n) by succ_eq_add_one at n
      have sm_eq : m + 1 = succ(m) by succ_eq_add_one at m
      have alar0 : for all b : Nat, for all c : Nat, n <= b implies n + c <= b + c
                   by add_le_add_right at n
      have alar1 : for all c : Nat, n <= m implies n + c <= m + c by alar0 at m
      have alar2 : n <= m implies n + 1 <= m + 1 by alar1 at 1
      have nm1 : n + 1 <= m + 1 by alar2 and hle
      have sn_sym : succ(n) = n + 1 by symm sn_eq
      have step1 : succ(n) <= m + 1 by eq_subst sn_sym and nm1
      have sm_sym : succ(m) = m + 1 by symm sm_eq
      have step_conc : succ(n) <= succ(m) by eq_subst sm_sym and step1
      have step : n < succ(m) implies succ(n) <= succ(m) by h and step_conc
      then n < succ(m) implies succ(n) <= succ(m) by step
end

-- succ(n) ≤ m ↔ n < m  (successor-le and strict-lt are inter-translatable).
-- Forward: succ(n) ≤ m and n < succ(n) give n < m by lt_le_trans.
-- Backward: lt_succ_le above.
theorem succ_le_iff : for all n : Nat, for all m : Nat, succ(n) <= m iff n < m
proof
  take n : Nat
  take m : Nat
  have fwd_impl : succ(n) <= m implies n < m
    proof
      suppose h_sle : succ(n) <= m
      have h_lt : n < succ(n) by lt_succ at n
      have llt0 : for all q : Nat, for all r : Nat, n < q implies q <= r implies n < r
                  by lt_le_trans at n
      have llt1 : for all r : Nat, n < succ(n) implies succ(n) <= r implies n < r
                  by llt0 at succ(n)
      have llt2 : n < succ(n) implies succ(n) <= m implies n < m by llt1 at m
      have llt3 : succ(n) <= m implies n < m by llt2 and h_lt
      have concl : n < m by llt3 and h_sle
      have impl : succ(n) <= m implies n < m by h_sle and concl
      then succ(n) <= m implies n < m by impl
    end
  have bwd_impl : n < m implies succ(n) <= m
    proof
      suppose h_lt : n < m
      have lsl0 : for all m : Nat, n < m implies succ(n) <= m by lt_succ_le at n
      have lsl1 : n < m implies succ(n) <= m by lsl0 at m
      have concl : succ(n) <= m by lsl1 and h_lt
      have impl : n < m implies succ(n) <= m by h_lt and concl
      then n < m implies succ(n) <= m by impl
    end
  have both : (succ(n) <= m implies n < m) and (n < m implies succ(n) <= m)
              by fwd_impl and bwd_impl
  then succ(n) <= m iff n < m by both
end

-- n < m → n ≤ m  (strict less-than implies less-than-or-equal).
theorem le_of_lt : for all n : Nat, for all m : Nat, n < m implies n <= m
proof
  take n : Nat
  take m : Nat
  suppose h : n < m
  then n <= m by omega
end

-- succ(n) < m → n < m  (weakening: if successor is strictly below, so is the original).
-- Proof: n < succ(n) and succ(n) < m give n < m by lt_trans.
theorem lt_of_succ_lt : for all n : Nat, for all m : Nat, succ(n) < m implies n < m
proof
  take n : Nat
  take m : Nat
  suppose h : succ(n) < m
  have h_lt : n < succ(n) by lt_succ at n
  have lt0 : for all q : Nat, for all r : Nat, n < q implies q < r implies n < r
             by lt_trans at n
  have lt1 : for all r : Nat, n < succ(n) implies succ(n) < r implies n < r
             by lt0 at succ(n)
  have lt2 : n < succ(n) implies succ(n) < m implies n < m by lt1 at m
  have lt3 : succ(n) < m implies n < m by lt2 and h_lt
  then n < m by lt3 and h
end

-- 0 < m → n < n + m  (adding a positive number increases value strictly).
theorem lt_add_of_pos_right : for all n : Nat, for all m : Nat, 0 < m implies n < n + m
proof
  take n : Nat
  take m : Nat
  suppose h : 0 < m
  then n < n + m by omega
end

-- succ(n) ≤ m → n ≤ m  (weaken: successor below implies original below).
-- Proof: succ_le_iff gives n < m; le_of_lt gives n ≤ m.
theorem le_of_succ_le : for all n : Nat, for all m : Nat, succ(n) <= m implies n <= m
proof
  take n : Nat
  take m : Nat
  suppose h : succ(n) <= m
  have sli0 : for all m : Nat, succ(n) <= m iff n < m by succ_le_iff at n
  have sli1 : succ(n) <= m iff n < m by sli0 at m
  -- iff desugars to (succ(n)<=m → n<m) ∧ (n<m → succ(n)<=m); AndElimL gives forward
  have sli_fwd : succ(n) <= m implies n < m by sli1
  have n_lt : n < m by sli_fwd and h
  have lol0 : for all m : Nat, n < m implies n <= m by le_of_lt at n
  have lol1 : n < m implies n <= m by lol0 at m
  then n <= m by lol1 and n_lt
end

-- n < m → succ(n) < succ(m)  (strict ordering preserved by successor).
-- Proof: lt_succ_le gives succ(n) ≤ m; lt_succ at m gives m < succ(m);
-- le_lt_trans gives succ(n) < succ(m).
theorem succ_lt_succ : for all n : Nat, for all m : Nat, n < m implies succ(n) < succ(m)
proof
  take n : Nat
  take m : Nat
  suppose h : n < m
  have lsl0 : for all m : Nat, n < m implies succ(n) <= m by lt_succ_le at n
  have lsl1 : n < m implies succ(n) <= m by lsl0 at m
  have sn_le : succ(n) <= m by lsl1 and h
  have m_lt : m < succ(m) by lt_succ at m
  have llt0 : for all q : Nat, for all r : Nat, succ(n) <= q implies q < r implies succ(n) < r
              by le_lt_trans at succ(n)
  have llt1 : for all r : Nat, succ(n) <= m implies m < r implies succ(n) < r
              by llt0 at m
  have llt2 : succ(n) <= m implies m < succ(m) implies succ(n) < succ(m)
              by llt1 at succ(m)
  have llt3 : m < succ(m) implies succ(n) < succ(m) by llt2 and sn_le
  then succ(n) < succ(m) by llt3 and m_lt
end

-- n ≤ succ(n)  (every number is below its successor).
theorem le_succ : for all n : Nat, n <= succ(n)
proof
  take n : Nat
  have h_lt : n < succ(n) by lt_succ at n
  have lol0 : for all m : Nat, n < m implies n <= m by le_of_lt at n
  have lol1 : n < succ(n) implies n <= succ(n) by lol0 at succ(n)
  then n <= succ(n) by lol1 and h_lt
end

-- a < b → c < d → a + c < b + d  (addition is strictly monotone in both arguments).
theorem add_lt_add : for all a : Nat, for all b : Nat, for all c : Nat, for all d : Nat,
                     a < b implies c < d implies a + c < b + d
proof
  take a : Nat
  take b : Nat
  take c : Nat
  take d : Nat
  suppose h1 : a < b
  suppose h2 : c < d
  then a + c < b + d by omega
end

-- 0 < n → m < m + n  (symmetric form of lt_add_of_pos_right).
theorem lt_add_of_pos_left : for all n : Nat, for all m : Nat, 0 < n implies m < m + n
proof
  take n : Nat
  take m : Nat
  suppose h : 0 < n
  then m < m + n by omega
end

-- k + a < k + b → a < b  (left-cancellation of addition in <).
theorem lt_of_add_lt_add_left : for all k : Nat, for all a : Nat, for all b : Nat,
                                 k + a < k + b implies a < b
proof
  take k : Nat
  take a : Nat
  take b : Nat
  suppose h : k + a < k + b
  then a < b by omega
end

-- k + a ≤ k + b → a ≤ b  (left-cancellation of addition in ≤).
theorem le_of_add_le_add_left : for all k : Nat, for all a : Nat, for all b : Nat,
                                 k + a <= k + b implies a <= b
proof
  take k : Nat
  take a : Nat
  take b : Nat
  suppose h : k + a <= k + b
  then a <= b by omega
end

-- succ(n) < succ(m) ↔ n < m  (successor is an order isomorphism).
theorem succ_lt_succ_iff : for all n : Nat, for all m : Nat,
                            succ(n) < succ(m) iff n < m
proof
  take n : Nat
  take m : Nat
  have fwd_impl : succ(n) < succ(m) implies n < m
    proof
      suppose h : succ(n) < succ(m)
      -- succ(n) < succ(m) → succ(n) ≤ m  by le_of_lt_succ at succ(n) at m
      have lofs0 : for all m : Nat, succ(n) < succ(m) implies succ(n) <= m
                   by le_of_lt_succ at succ(n)
      have lofs1 : succ(n) < succ(m) implies succ(n) <= m by lofs0 at m
      have hle : succ(n) <= m by lofs1 and h
      -- succ(n) ≤ m → n < m  by succ_le_iff
      have sli0 : for all m : Nat, succ(n) <= m iff n < m by succ_le_iff at n
      have sli1 : succ(n) <= m iff n < m by sli0 at m
      have sli_fwd : succ(n) <= m implies n < m by sli1
      have n_lt : n < m by sli_fwd and hle
      have impl : succ(n) < succ(m) implies n < m by h and n_lt
      then succ(n) < succ(m) implies n < m by impl
    end
  have bwd_impl : n < m implies succ(n) < succ(m)
    proof
      suppose h : n < m
      have scs0 : for all m : Nat, n < m implies succ(n) < succ(m) by succ_lt_succ at n
      have scs1 : n < m implies succ(n) < succ(m) by scs0 at m
      have concl : succ(n) < succ(m) by scs1 and h
      have impl : n < m implies succ(n) < succ(m) by h and concl
      then n < m implies succ(n) < succ(m) by impl
    end
  have both : (succ(n) < succ(m) implies n < m) and (n < m implies succ(n) < succ(m))
              by fwd_impl and bwd_impl
  then succ(n) < succ(m) iff n < m by both
end

-- succ(n) ≤ succ(m) → n ≤ m  (successor is ≤-monotone inverse).
theorem le_of_succ_le_succ : for all n : Nat, for all m : Nat, succ(n) <= succ(m) implies n <= m
proof
  take n : Nat
  take m : Nat
  suppose h : succ(n) <= succ(m)
  -- succ(n) ≤ succ(m) → n < succ(m) by succ_le_iff
  have sli0 : for all m : Nat, succ(n) <= m iff n < m by succ_le_iff at n
  have sli1 : succ(n) <= succ(m) iff n < succ(m) by sli0 at succ(m)
  have sli_fwd : succ(n) <= succ(m) implies n < succ(m) by sli1
  have n_lt : n < succ(m) by sli_fwd and h
  -- n < succ(m) → n ≤ m
  have lofs0 : for all m : Nat, n < succ(m) implies n <= m by le_of_lt_succ at n
  have lofs1 : n < succ(m) implies n <= m by lofs0 at m
  then n <= m by lofs1 and n_lt
end

-- n < succ(m) ↔ n ≤ m  (successor boundary).
theorem lt_succ_iff_le : for all n : Nat, for all m : Nat, n < succ(m) iff n <= m
proof
  take n : Nat
  take m : Nat
  have fwd_impl : n < succ(m) implies n <= m
    proof
      suppose h : n < succ(m)
      have lofs0 : for all m : Nat, n < succ(m) implies n <= m by le_of_lt_succ at n
      have lofs1 : n < succ(m) implies n <= m by lofs0 at m
      have concl : n <= m by lofs1 and h
      have impl : n < succ(m) implies n <= m by h and concl
      then n < succ(m) implies n <= m by impl
    end
  have bwd_impl : n <= m implies n < succ(m)
    proof
      suppose h : n <= m
      -- n ≤ m → n < succ(m):  n ≤ m ≤ ... use le_lt_trans or le_succ + le_lt_trans
      -- Directly: n < succ(n) ≤ succ(m) when n ≤ m.
      -- succ(n) ≤ succ(m) from n ≤ m... but we don't have that lemma yet.
      -- Alternative: n ≤ m, m < succ(m), so n < succ(m) by le_lt_trans.
      have m_lt : m < succ(m) by lt_succ at m
      have llt0 : for all q : Nat, for all r : Nat, n <= q implies q < r implies n < r
                  by le_lt_trans at n
      have llt1 : for all r : Nat, n <= m implies m < r implies n < r by llt0 at m
      have llt2 : n <= m implies m < succ(m) implies n < succ(m) by llt1 at succ(m)
      have llt3 : m < succ(m) implies n < succ(m) by llt2 and h
      have concl : n < succ(m) by llt3 and m_lt
      have impl : n <= m implies n < succ(m) by h and concl
      then n <= m implies n < succ(m) by impl
    end
  have both : (n < succ(m) implies n <= m) and (n <= m implies n < succ(m))
              by fwd_impl and bwd_impl
  then n < succ(m) iff n <= m by both
end

-- a = b → a + c = b + c  (right-congruence of addition).
theorem add_right_cong : for all a : Nat, for all b : Nat, for all c : Nat,
                         a = b implies a + c = b + c
proof
  take a : Nat
  take b : Nat
  take c : Nat
  suppose h : a = b
  then a + c = b + c by omega
end

-- n ≤ m → succ(n) ≤ succ(m)  (successor is ≤-monotone).
theorem succ_le_succ : for all n : Nat, for all m : Nat, n <= m implies succ(n) <= succ(m)
proof
  take n : Nat
  take m : Nat
  suppose h : n <= m
  -- n ≤ m → n < succ(m) by lt_succ_iff_le (backward)
  have lsi0 : for all m : Nat, n < succ(m) iff n <= m by lt_succ_iff_le at n
  have lsi1 : n < succ(m) iff n <= m by lsi0 at m
  have lsi_bwd : n <= m implies n < succ(m) by lsi1
  have n_lt : n < succ(m) by lsi_bwd and h
  -- n < succ(m) → succ(n) ≤ succ(m) by lt_succ_le at n at succ(m)
  have lsl0 : for all m : Nat, n < m implies succ(n) <= m by lt_succ_le at n
  have lsl1 : n < succ(m) implies succ(n) <= succ(m) by lsl0 at succ(m)
  then succ(n) <= succ(m) by lsl1 and n_lt
end

-- n ≤ m → n < succ(m)  (corollary of lt_succ_iff_le).
theorem lt_succ_of_le : for all n : Nat, for all m : Nat, n <= m implies n < succ(m)
proof
  take n : Nat
  take m : Nat
  suppose h : n <= m
  have lsi0 : for all m : Nat, n < succ(m) iff n <= m by lt_succ_iff_le at n
  have lsi1 : n < succ(m) iff n <= m by lsi0 at m
  have lsi_bwd : n <= m implies n < succ(m) by lsi1
  then n < succ(m) by lsi_bwd and h
end

-- n ≤ m ↔ succ(n) ≤ succ(m)  (successor preserves ≤ order, both ways).
theorem succ_le_succ_iff : for all n : Nat, for all m : Nat,
                            succ(n) <= succ(m) iff n <= m
proof
  take n : Nat
  take m : Nat
  have fwd_impl : succ(n) <= succ(m) implies n <= m
    proof
      suppose h : succ(n) <= succ(m)
      have lss0 : for all m : Nat, succ(n) <= succ(m) implies n <= m by le_of_succ_le_succ at n
      have lss1 : succ(n) <= succ(m) implies n <= m by lss0 at m
      have concl : n <= m by lss1 and h
      have impl : succ(n) <= succ(m) implies n <= m by h and concl
      then succ(n) <= succ(m) implies n <= m by impl
    end
  have bwd_impl : n <= m implies succ(n) <= succ(m)
    proof
      suppose h : n <= m
      have sss0 : for all m : Nat, n <= m implies succ(n) <= succ(m) by succ_le_succ at n
      have sss1 : n <= m implies succ(n) <= succ(m) by sss0 at m
      have concl : succ(n) <= succ(m) by sss1 and h
      have impl : n <= m implies succ(n) <= succ(m) by h and concl
      then n <= m implies succ(n) <= succ(m) by impl
    end
  have both : (succ(n) <= succ(m) implies n <= m) and (n <= m implies succ(n) <= succ(m))
              by fwd_impl and bwd_impl
  then succ(n) <= succ(m) iff n <= m by both
end

-- n + m = 0 → n = 0  (if a sum of naturals is zero then left summand is zero).
theorem add_eq_zero : for all n : Nat, for all m : Nat, n + m = 0 implies n = 0
proof
  take n : Nat
  take m : Nat
  suppose h : n + m = 0
  have hn : 0 <= n by nat_le_zero at n
  have hm : 0 <= m by nat_le_zero at m
  then n = 0 by omega
end

-- n + m = n → m = 0  (if a sum equals its left operand then the right is zero).
theorem add_left_zero : for all n : Nat, for all m : Nat, n + m = n implies m = 0
proof
  take n : Nat
  take m : Nat
  suppose h : n + m = n
  have hm : 0 <= m by nat_le_zero at m
  then m = 0 by omega
end

-- n ≤ n + m  (a number does not exceed its sum with another).
-- Already have le_add_right; this is the same thing but stated for completeness.
-- Alias: see le_add_right.

-- a < b → a + 1 ≤ b  (equivalent to succ(a) ≤ b via succ = +1).
theorem lt_iff_add_one_le : for all a : Nat, for all b : Nat, a < b implies a + 1 <= b
proof
  take a : Nat
  take b : Nat
  suppose h : a < b
  have sn_eq : a + 1 = succ(a) by succ_eq_add_one at a
  have lsl0 : for all m : Nat, a < m implies succ(a) <= m by lt_succ_le at a
  have lsl1 : a < b implies succ(a) <= b by lsl0 at b
  have h_succ : succ(a) <= b by lsl1 and h
  have sn_sym : succ(a) = a + 1 by symm sn_eq
  have h_r : a + 1 <= b by omega
  then a + 1 <= b by h_r
end

-- a ≤ b → a * k ≤ b * k  (multiplication is monotone on the right).
theorem mul_le_mul_right : for all a : Nat, for all b : Nat, for all k : Nat,
                            a <= b implies a * k <= b * k
proof
  take a : Nat
  take b : Nat
  induction result on k : a <= b implies a * k <= b * k
    base:
      -- a * 0 = 0 = b * 0
      have az : a * 0 = 0 by mul_zero at a
      have bz : b * 0 = 0 by mul_zero at b
      have impl : a <= b implies a * 0 <= b * 0
        proof
          suppose h_ab : a <= b
          have concl : a * 0 <= b * 0 by omega
          have i : a <= b implies a * 0 <= b * 0 by h_ab and concl
          then a <= b implies a * 0 <= b * 0 by i
        end
      then a <= b implies a * 0 <= b * 0 by impl
    inductive:
      -- IH: ih : a <= b implies a * k <= b * k
      -- Goal: a <= b implies a * succ(k) <= b * succ(k)
      suppose h_ab : a <= b
      -- a * succ(k) = a * k + a  by mul_succ at a at k
      have mas1 : for all m : Nat, a * succ(m) = a * m + a by mul_succ at a
      have mas2 : a * succ(k) = a * k + a by mas1 at k
      -- b * succ(k) = b * k + b  by mul_succ at b at k
      have mbs1 : for all m : Nat, b * succ(m) = b * m + b by mul_succ at b
      have mbs2 : b * succ(k) = b * k + b by mbs1 at k
      -- a * k <= b * k  by IH
      have ih_app : a <= b implies a * k <= b * k by ih
      have h_mul : a * k <= b * k by ih_app and h_ab
      -- a * k + a <= b * k + b  by add_le_add at (a*k) at (b*k) at a at b
      -- Bound vars in add_le_add are a,b,c,d; outer free are a,b,k.
      -- At (a*k): remaining ∀ b c d; outer b conflicts, but at (b*k) gives remaining ∀ c d.
      -- c,d don't conflict with outer k; at a then at b gives a*k≤b*k → a≤b → a*k+a≤b*k+b.
      have add1 : for all b : Nat, for all c : Nat, for all d : Nat,
                  a * k <= b implies c <= d implies a * k + c <= b + d
                  by add_le_add at (a * k)
      have add2 : for all c : Nat, for all d : Nat,
                  a * k <= b * k implies c <= d implies a * k + c <= b * k + d
                  by add1 at (b * k)
      have add3 : for all d : Nat, a * k <= b * k implies a <= d implies a * k + a <= b * k + d
                  by add2 at a
      have add4 : a * k <= b * k implies a <= b implies a * k + a <= b * k + b by add3 at b
      have h_sum_impl : a <= b implies a * k + a <= b * k + b by add4 and h_mul
      have h_sum : a * k + a <= b * k + b by h_sum_impl and h_ab
      -- Convert: a*succ(k) = a*k+a, b*succ(k) = b*k+b.
      -- eq_subst EQ and PREMISE: subst lhs(EQ)→rhs(EQ) in declared type; check = PREMISE.
      -- So for h_r1 : a*succ(k) ≤ b*k+b: use eq=mas2 (a*succ(k)=a*k+a); subst in declared→a*k+a≤b*k+b=h_sum
      have h_r1 : a * succ(k) <= b * k + b by eq_subst mas2 and h_sum
      -- For result : a*succ(k) ≤ b*succ(k): use eq=mbs2 (b*succ(k)=b*k+b); subst in declared→a*succ(k)≤b*k+b=h_r1
      have result : a * succ(k) <= b * succ(k) by eq_subst mbs2 and h_r1
      have impl_step : a <= b implies a * succ(k) <= b * succ(k) by h_ab and result
      then a <= b implies a * succ(k) <= b * succ(k) by impl_step
end
