import "rat.forall"

-- Derived theorems about rationals, proved from the ordered field axioms.

-- ¬(a < a)  (strict inequality on Rat is irreflexive).
theorem rat_lt_irrefl : for all a : Rat, not (a < a)
proof
  take a : Rat
  have result : not (a < a)
    proof
      suppose h : a < a
      have f : false by omega
      then not (a < a) by h and f
    end
  then not (a < a) by result
end

-- a < b → a + c < b + c  (addition is strictly monotone on the right).
theorem rat_add_lt_add_right : for all a : Rat, for all b : Rat, for all c : Rat,
    a < b implies a + c < b + c
proof
  take a : Rat
  take b : Rat
  take c : Rat
  suppose h : a < b
  -- Rat_lt_add : ∀ x y z, x < y → x + z < y + z.
  have lt0 : for all y : Rat, for all z : Rat, a < y implies a + z < y + z
             by Rat_lt_add at a
  have lt1 : for all z : Rat, a < b implies a + z < b + z by lt0 at b
  have lt2 : a < b implies a + c < b + c by lt1 at c
  then a + c < b + c by lt2 and h
end

-- a < b → c + a < c + b  (addition is strictly monotone on the left).
theorem rat_add_lt_add_left : for all a : Rat, for all b : Rat, for all c : Rat,
    a < b implies c + a < c + b
proof
  take a : Rat
  take b : Rat
  take c : Rat
  suppose h : a < b
  have lt0 : for all y : Rat, for all z : Rat, a < y implies a + z < y + z
             by Rat_lt_add at a
  have lt1 : for all z : Rat, a < b implies a + z < b + z by lt0 at b
  have lt2 : a < b implies a + c < b + c by lt1 at c
  have lt3 : a + c < b + c by lt2 and h
  then c + a < c + b by omega
end

-- a + b = a + c → b = c  (left cancellation of addition).
theorem rat_add_right_cancel : for all a : Rat, for all b : Rat, for all c : Rat,
    a + b = a + c implies b = c
proof
  take a : Rat
  take b : Rat
  take c : Rat
  suppose h : a + b = a + c
  then b = c by omega
end

-- b + a = c + a → b = c  (right cancellation of addition).
theorem rat_add_left_cancel : for all a : Rat, for all b : Rat, for all c : Rat,
    b + a = c + a implies b = c
proof
  take a : Rat
  take b : Rat
  take c : Rat
  suppose h : b + a = c + a
  then b = c by omega
end

-- 0 < 1  (the unit is positive).
theorem rat_zero_lt_one : 0 < 1
proof
  then 0 < 1 by Rat_zero_lt_one
end

-- a < b → b < c → a < c  (strict ordering is transitive).
theorem rat_lt_trans : for all a : Rat, for all b : Rat, for all c : Rat,
    a < b implies b < c implies a < c
proof
  take a : Rat
  take b : Rat
  take c : Rat
  suppose h1 : a < b
  suppose h2 : b < c
  have tr0 : for all y : Rat, for all z : Rat, a < y implies y < z implies a < z
             by Rat_lt_trans at a
  have tr1 : for all z : Rat, a < b implies b < z implies a < z by tr0 at b
  have tr2 : a < b implies b < c implies a < c by tr1 at c
  have tr3 : b < c implies a < c by tr2 and h1
  then a < c by tr3 and h2
end

-- a > 0 → b > 0 → a * b > 0  (product of positive rationals is positive).
theorem rat_mul_pos : for all a : Rat, for all b : Rat,
    a > 0 implies b > 0 implies a * b > 0
proof
  take a : Rat
  take b : Rat
  suppose ha : a > 0
  suppose hb : b > 0
  -- Rat_lt_mul_pos : ∀ x y, x > 0 → y > 0 → x * y > 0.
  have mp0 : for all y : Rat, a > 0 implies y > 0 implies a * y > 0
             by Rat_lt_mul_pos at a
  have mp1 : a > 0 implies b > 0 implies a * b > 0 by mp0 at b
  have mp2 : b > 0 implies a * b > 0 by mp1 and ha
  then a * b > 0 by mp2 and hb
end
