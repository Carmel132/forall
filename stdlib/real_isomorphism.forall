import "real_dc_field.forall"
import "real_cs_field.forall"

open Analysis

-- Isomorphism between the two constructions of the real numbers.
--
-- Both Real_DC (Dedekind cuts) and Real_CS (Cauchy sequences) are complete ordered
-- fields. A classical theorem of real analysis — the categoricity of the complete
-- ordered field — states that any two such structures are uniquely isomorphic.
--
-- This file defines the isomorphism maps and states their key properties as axioms,
-- since the constructive proof would require significant analytic machinery
-- (rational approximations to Dedekind cuts, Cauchy completeness arguments).
--
-- Theorem (Categoricity): Any two complete ordered fields are isomorphic as ordered
-- fields, and the isomorphism is unique. This means Real_DC and Real_CS are, up to
-- unique isomorphism, the same mathematical object — "the real numbers."

-- Forward map: Dedekind cut → Cauchy sequence representative.
-- Given a Dedekind cut L (a set of rationals), produce the Cauchy sequence
-- [a_n] where a_n is the largest rational with denominator ≤ n that lies in L.
-- This sequence is Cauchy (the cut's no-maximum property ensures we can
-- approximate sup(L) arbitrarily closely) and represents the real number sup(L).
abstract definition dedekind_to_cauchy (x : Real_DC) : Prop

-- Backward map: Cauchy sequence equivalence class → Dedekind cut.
-- Given [a_n], produce the cut L = {q : RatQ | ∃ N, ∀ n ≥ N, q < a_n}.
-- This is a Dedekind cut (the lower cut defined by the eventual limit of a_n).
abstract definition cauchy_to_dedekind (x : Real_CS) : Prop

-- The maps are mutually inverse.
axiom dedekind_cauchy_inverse :
    for all x : Real_DC,
        cauchy_to_dedekind(dedekind_to_cauchy(x)) = x

axiom cauchy_dedekind_inverse :
    for all x : Real_CS,
        dedekind_to_cauchy(cauchy_to_dedekind(x)) = x

-- The forward map preserves addition.
axiom dedekind_to_cauchy_add :
    for all x : Real_DC, for all y : Real_DC,
        dedekind_to_cauchy(real_dc_add(x, y)) =
        real_cs_add(dedekind_to_cauchy(x), dedekind_to_cauchy(y))

-- The forward map preserves multiplication.
axiom dedekind_to_cauchy_mul :
    for all x : Real_DC, for all y : Real_DC,
        dedekind_to_cauchy(real_dc_mul(x, y)) =
        real_cs_mul(dedekind_to_cauchy(x), dedekind_to_cauchy(y))

-- The forward map sends zero to zero.
axiom dedekind_to_cauchy_zero :
    dedekind_to_cauchy(real_dc_zero) = real_cs_zero

-- The forward map sends one to one.
axiom dedekind_to_cauchy_one :
    dedekind_to_cauchy(real_dc_one) = real_cs_one

-- The forward map preserves strict order.
axiom dedekind_to_cauchy_lt :
    for all x : Real_DC, for all y : Real_DC,
        real_dc_lt(x, y) implies
        real_cs_lt(dedekind_to_cauchy(x), dedekind_to_cauchy(y))

-- Injectivity of dedekind_to_cauchy (follows from the existence of a left inverse).
-- If dtc(x) = dtc(y) then x = ctd(dtc(x)) = ctd(dtc(y)) = y.
-- The congruence step (applying ctd to both sides) is stated as an axiom since
-- the `by eq_subst` tactic requires a variable on one side of the hypothesis.
axiom dedekind_to_cauchy_injective :
    for all x : Real_DC, for all y : Real_DC,
        dedekind_to_cauchy(x) = dedekind_to_cauchy(y) implies x = y

-- The backward map also preserves addition.
axiom cauchy_to_dedekind_add :
    for all x : Real_CS, for all y : Real_CS,
        cauchy_to_dedekind(real_cs_add(x, y)) =
        real_dc_add(cauchy_to_dedekind(x), cauchy_to_dedekind(y))

-- The backward map sends zero to zero.
axiom cauchy_to_dedekind_zero :
    cauchy_to_dedekind(real_cs_zero) = real_dc_zero

-- The backward map sends one to one.
axiom cauchy_to_dedekind_one :
    cauchy_to_dedekind(real_cs_one) = real_dc_one

-- Categoricity: the isomorphism is unique.
-- Any field homomorphism φ : Real_DC → Real_CS that preserves order must
-- equal dedekind_to_cauchy. (Stated as an axiom; constructive proof deferred.)
axiom real_field_iso_unique :
    for all phi : Real_DC -> Real_CS,
        (for all x : Real_DC, for all y : Real_DC,
            phi(real_dc_add(x, y)) = real_cs_add(phi(x), phi(y))) implies
        (for all x : Real_DC, for all y : Real_DC,
            phi(real_dc_mul(x, y)) = real_cs_mul(phi(x), phi(y))) implies
        (phi(real_dc_zero) = real_cs_zero) implies
        (phi(real_dc_one) = real_cs_one) implies
        (for all x : Real_DC,
            phi(x) = dedekind_to_cauchy(x))
