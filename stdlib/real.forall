-- Ordered field axioms for Real
--
-- These axioms characterise R as a complete ordered field (completeness deferred).
-- They are stated axiomatically; a constructive definition via Dedekind cuts or
-- Cauchy sequences requires user-defined types and is explicitly out of scope.
--
-- Axiom names follow the convention  <TypeName>_<law>  so that
-- `instance Real : OrderedField` can resolve them implicitly.

-- Additive group
axiom Real_add_comm        : for all x : Real, for all y : Real, x + y = y + x
axiom Real_add_assoc       : for all x : Real, for all y : Real, for all z : Real, (x + y) + z = x + (y + z)
axiom Real_add_zero        : for all x : Real, x + 0 = x
axiom Real_zero_add        : for all x : Real, 0 + x = x
axiom Real_add_neg         : for all x : Real, there exists y : Real, x + y = 0

-- Multiplicative group (on nonzero elements)
axiom Real_mul_comm        : for all x : Real, for all y : Real, x * y = y * x
axiom Real_mul_assoc       : for all x : Real, for all y : Real, for all z : Real, (x * y) * z = x * (y * z)
axiom Real_mul_one         : for all x : Real, x * 1 = x
axiom Real_one_mul         : for all x : Real, 1 * x = x
axiom Real_mul_inv         : for all x : Real, not (x = 0) implies there exists y : Real, x * y = 1

-- Distributivity
axiom Real_distrib_left    : for all x : Real, for all y : Real, for all z : Real, x * (y + z) = x * y + x * z
axiom Real_distrib_right   : for all x : Real, for all y : Real, for all z : Real, (x + y) * z = x * z + y * z

-- Order
axiom Real_order_total     : for all x : Real, for all y : Real, x < y or x = y or y < x
axiom Real_lt_trans        : for all x : Real, for all y : Real, for all z : Real, x < y implies y < z implies x < z
axiom Real_lt_add          : for all x : Real, for all y : Real, for all z : Real, x < y implies x + z < y + z
axiom Real_lt_mul_pos      : for all x : Real, for all y : Real, x > 0 implies y > 0 implies x * y > 0
axiom Real_zero_lt_one     : 0 < 1

instance Real : OrderedField
