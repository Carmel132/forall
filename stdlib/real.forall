-- Ordered field axioms for Real
--
-- These axioms characterise R as a complete ordered field (completeness deferred).
-- They are stated axiomatically; a constructive definition via Dedekind cuts or
-- Cauchy sequences requires user-defined types and is explicitly out of scope.

-- Additive group
axiom add_comm_real  : for all x : Real, for all y : Real, x + y = y + x
axiom add_assoc_real : for all x : Real, for all y : Real, for all z : Real, x + y + z = x + (y + z)
axiom add_zero_real  : for all x : Real, x + 0 = x
axiom add_inv_real   : for all x : Real, there exists y : Real, x + y = 0

-- Multiplicative group (on nonzero elements)
axiom mul_comm_real  : for all x : Real, for all y : Real, x * y = y * x
axiom mul_assoc_real : for all x : Real, for all y : Real, for all z : Real, x * y * z = x * (y * z)
axiom mul_one_real   : for all x : Real, x * 1 = x
axiom mul_inv_real   : for all x : Real, not (x = 0) implies there exists y : Real, x * y = 1

-- Distributivity
axiom distrib_real : for all x : Real, for all y : Real, for all z : Real, x * (y + z) = x * y + x * z

-- Order
axiom order_total        : for all x : Real, for all y : Real, x < y or x = y or y < x
axiom order_trans        : for all x : Real, for all y : Real, for all z : Real, x < y implies y < z implies x < z
axiom order_add_compat   : for all x : Real, for all y : Real, for all z : Real, x < y implies x + z < y + z
axiom order_mul_pos      : for all x : Real, for all y : Real, x > 0 implies y > 0 implies x * y > 0
axiom zero_lt_one        : 0 < 1
