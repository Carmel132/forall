import "set_theory.forall"

-- Derived theorems about sets, proved from the axioms in set_theory.forall.
--
-- Variable naming convention: use P, Q, R to avoid capture with the axiom-internal
-- bound variables A, B, x (which appear in inter_def, subset_def, etc.).

-- A ∩ B ⊆ A.
theorem inter_subset_left :
  for all T : Type, for all P : Set T, for all Q : Set T,
    P inter Q subseteq P
proof
  take T : Type
  take P : Set T
  take Q : Set T
  have id1 : for all A : Set T, for all B : Set T, for all x : T,
               x in A inter B iff (x in A and x in B)
             by inter_def at T
  have id2 : for all B : Set T, for all x : T,
               x in P inter B iff (x in P and x in B)
             by id1 at P
  have id3 : for all x : T,
               x in P inter Q iff (x in P and x in Q)
             by id2 at Q
  have mem_dir : for all x : T, x in (P inter Q) implies x in P
  proof
    take x : T
    suppose h_mem : x in P inter Q
    have id4 : x in P inter Q iff (x in P and x in Q) by id3 at x
    have fwd  : x in P inter Q -> (x in P and x in Q) by id4
    have both : x in P and x in Q by fwd and h_mem
    have h_p  : x in P by both
    have impl : x in P inter Q -> x in P by h_mem and h_p
    have fa   : for all x : T, x in P inter Q -> x in P by impl
    then for all x : T, x in (P inter Q) implies x in P by fa
  end
  have sd1 : for all A : Set T, for all B : Set T,
               A subseteq B iff (for all x : T, x in A implies x in B)
             by subset_def at T
  have sd2 : for all B : Set T,
               (P inter Q) subseteq B iff (for all x : T, x in (P inter Q) implies x in B)
             by sd1 at (P inter Q)
  have sd3 : (P inter Q) subseteq P iff (for all x : T, x in (P inter Q) implies x in P)
             by sd2 at P
  have sd_back : (for all x : T, x in (P inter Q) implies x in P) ->
                   (P inter Q) subseteq P
                 by sd3
  then P inter Q subseteq P by sd_back and mem_dir
end

-- A ∩ B ⊆ B.
theorem inter_subset_right :
  for all T : Type, for all P : Set T, for all Q : Set T,
    P inter Q subseteq Q
proof
  take T : Type
  take P : Set T
  take Q : Set T
  have id1 : for all A : Set T, for all B : Set T, for all x : T,
               x in A inter B iff (x in A and x in B)
             by inter_def at T
  have id2 : for all B : Set T, for all x : T,
               x in P inter B iff (x in P and x in B)
             by id1 at P
  have id3 : for all x : T,
               x in P inter Q iff (x in P and x in Q)
             by id2 at Q
  have mem_dir : for all x : T, x in (P inter Q) implies x in Q
  proof
    take x : T
    suppose h_mem : x in P inter Q
    have id4 : x in P inter Q iff (x in P and x in Q) by id3 at x
    have fwd  : x in P inter Q -> (x in P and x in Q) by id4
    have both : x in P and x in Q by fwd and h_mem
    have h_q  : x in Q by both
    have impl : x in P inter Q -> x in Q by h_mem and h_q
    have fa   : for all x : T, x in P inter Q -> x in Q by impl
    then for all x : T, x in (P inter Q) implies x in Q by fa
  end
  have sd1 : for all A : Set T, for all B : Set T,
               A subseteq B iff (for all x : T, x in A implies x in B)
             by subset_def at T
  have sd2 : for all B : Set T,
               (P inter Q) subseteq B iff (for all x : T, x in (P inter Q) implies x in B)
             by sd1 at (P inter Q)
  have sd3 : (P inter Q) subseteq Q iff (for all x : T, x in (P inter Q) implies x in Q)
             by sd2 at Q
  have sd_back : (for all x : T, x in (P inter Q) implies x in Q) ->
                   (P inter Q) subseteq Q
                 by sd3
  then P inter Q subseteq Q by sd_back and mem_dir
end

-- P ⊆ P ∪ Q.
theorem union_supset_left :
  for all T : Type, for all P : Set T, for all Q : Set T,
    P subseteq P union Q
proof
  take T : Type
  take P : Set T
  take Q : Set T
  have ud1 : for all A : Set T, for all B : Set T, for all x : T,
               x in A union B iff (x in A or x in B)
             by union_def at T
  have ud2 : for all B : Set T, for all x : T,
               x in P union B iff (x in P or x in B)
             by ud1 at P
  have ud3 : for all x : T,
               x in P union Q iff (x in P or x in Q)
             by ud2 at Q
  have mem_dir : for all x : T, x in P implies x in (P union Q)
  proof
    take x : T
    suppose h_p : x in P
    have ud4 : x in P union Q iff (x in P or x in Q) by ud3 at x
    have fwd  : (x in P or x in Q) -> x in P union Q by ud4
    have h_or : x in P or x in Q by h_p
    have h_pu : x in P union Q by fwd and h_or
    have impl : x in P -> x in P union Q by h_p and h_pu
    have fa   : for all x : T, x in P -> x in P union Q by impl
    then for all x : T, x in P implies x in (P union Q) by fa
  end
  have sd1 : for all A : Set T, for all B : Set T,
               A subseteq B iff (for all x : T, x in A implies x in B)
             by subset_def at T
  have sd2 : for all B : Set T,
               P subseteq B iff (for all x : T, x in P implies x in B)
             by sd1 at P
  have sd3 : P subseteq (P union Q) iff (for all x : T, x in P implies x in (P union Q))
             by sd2 at (P union Q)
  have sd_back : (for all x : T, x in P implies x in (P union Q)) ->
                   P subseteq (P union Q)
                 by sd3
  then P subseteq P union Q by sd_back and mem_dir
end

-- P ⊆ R → Q ⊆ R → P ∪ Q ⊆ R  (union is the join/least upper bound).
theorem union_subset_both :
  for all T : Type, for all P : Set T, for all Q : Set T, for all R : Set T,
    P subseteq R -> Q subseteq R -> P union Q subseteq R
proof
  take T : Type
  take P : Set T
  take Q : Set T
  take R : Set T
  suppose h_pr : P subseteq R
  suppose h_qr : Q subseteq R
  -- Unfold union membership
  have ud1 : for all A : Set T, for all B : Set T, for all x : T,
               x in A union B iff (x in A or x in B)
             by union_def at T
  have ud2 : for all B : Set T, for all x : T,
               x in P union B iff (x in P or x in B)
             by ud1 at P
  have ud3 : for all x : T,
               x in P union Q iff (x in P or x in Q)
             by ud2 at Q
  -- Unfold P ⊆ R to membership implication
  have sd_all : for all A : Set T, for all B : Set T,
                  A subseteq B iff (for all x : T, x in A implies x in B)
                by subset_def at T
  have sd_p1 : for all B : Set T,
                 P subseteq B iff (for all x : T, x in P implies x in B)
               by sd_all at P
  have sd_pr : P subseteq R iff (for all x : T, x in P implies x in R)
               by sd_p1 at R
  have pimpl : P subseteq R -> (for all x : T, x in P implies x in R) by sd_pr
  have p_mem : for all x : T, x in P implies x in R by pimpl and h_pr
  -- Unfold Q ⊆ R to membership implication
  have sd_q1 : for all B : Set T,
                 Q subseteq B iff (for all x : T, x in Q implies x in B)
               by sd_all at Q
  have sd_qr : Q subseteq R iff (for all x : T, x in Q implies x in R)
               by sd_q1 at R
  have qimpl : Q subseteq R -> (for all x : T, x in Q implies x in R) by sd_qr
  have q_mem : for all x : T, x in Q implies x in R by qimpl and h_qr
  -- Prove each element of P ∪ Q is in R
  have mem_dir : for all x : T, x in (P union Q) implies x in R
  proof
    take x : T
    suppose h_pu : x in P union Q
    have ud4      : x in P union Q iff (x in P or x in Q) by ud3 at x
    have get      : x in P union Q -> (x in P or x in Q) by ud4
    have h_or     : x in P or x in Q by get and h_pu
    have h_p_impl : x in P implies x in R by p_mem at x
    have h_q_impl : x in Q implies x in R by q_mem at x
    have h_pr_i   : x in P -> x in R by h_p_impl
    have h_qr_i   : x in Q -> x in R by h_q_impl
    -- OrElim: (x in P or x in Q), (x in P -> x in R), (x in Q -> x in R) ⊢ x in R
    have h_r      : x in R by h_or and h_pr_i and h_qr_i
    have impl     : x in P union Q -> x in R by h_pu and h_r
    have fa       : for all x : T, x in P union Q -> x in R by impl
    then for all x : T, x in (P union Q) implies x in R by fa
  end
  -- Convert back to subset form
  have sd_pu1 : for all B : Set T,
                  (P union Q) subseteq B iff (for all x : T, x in (P union Q) implies x in B)
                by sd_all at (P union Q)
  have sd_pu : (P union Q) subseteq R iff (for all x : T, x in (P union Q) implies x in R)
               by sd_pu1 at R
  have sd_back : (for all x : T, x in (P union Q) implies x in R) ->
                   (P union Q) subseteq R
                 by sd_pu
  then P union Q subseteq R by sd_back and mem_dir
end

-- R ⊆ P → R ⊆ Q → R ⊆ P ∩ Q  (intersection is the meet/greatest lower bound).
theorem inter_supset_both :
  for all T : Type, for all P : Set T, for all Q : Set T, for all R : Set T,
    R subseteq P -> R subseteq Q -> R subseteq P inter Q
proof
  take T : Type
  take P : Set T
  take Q : Set T
  take R : Set T
  suppose h_rp : R subseteq P
  suppose h_rq : R subseteq Q
  -- Unfold intersection membership
  have id1 : for all A : Set T, for all B : Set T, for all x : T,
               x in A inter B iff (x in A and x in B)
             by inter_def at T
  have id2 : for all B : Set T, for all x : T,
               x in P inter B iff (x in P and x in B)
             by id1 at P
  have id3 : for all x : T,
               x in P inter Q iff (x in P and x in Q)
             by id2 at Q
  -- Unfold R ⊆ P to membership implication
  have sd_all : for all A : Set T, for all B : Set T,
                  A subseteq B iff (for all x : T, x in A implies x in B)
                by subset_def at T
  have sd_r1 : for all B : Set T,
                 R subseteq B iff (for all x : T, x in R implies x in B)
               by sd_all at R
  have sd_rp : R subseteq P iff (for all x : T, x in R implies x in P)
               by sd_r1 at P
  have pimpl : R subseteq P -> (for all x : T, x in R implies x in P) by sd_rp
  have r_to_p : for all x : T, x in R implies x in P by pimpl and h_rp
  -- Unfold R ⊆ Q to membership implication
  have sd_rq : R subseteq Q iff (for all x : T, x in R implies x in Q)
               by sd_r1 at Q
  have qimpl : R subseteq Q -> (for all x : T, x in R implies x in Q) by sd_rq
  have r_to_q : for all x : T, x in R implies x in Q by qimpl and h_rq
  -- Prove each element of R is in P ∩ Q
  have mem_dir : for all x : T, x in R implies x in (P inter Q)
  proof
    take x : T
    suppose h_r : x in R
    have h_p_impl : x in R implies x in P by r_to_p at x
    have h_q_impl : x in R implies x in Q by r_to_q at x
    have h_p      : x in P by h_p_impl and h_r
    have h_q      : x in Q by h_q_impl and h_r
    have h_both   : x in P and x in Q by h_p and h_q
    have id4      : x in P inter Q iff (x in P and x in Q) by id3 at x
    have put      : (x in P and x in Q) -> x in P inter Q by id4
    have h_pi     : x in P inter Q by put and h_both
    have impl     : x in R -> x in P inter Q by h_r and h_pi
    have fa       : for all x : T, x in R -> x in P inter Q by impl
    then for all x : T, x in R implies x in (P inter Q) by fa
  end
  -- Convert back to subset form
  have sd_ri1 : for all B : Set T,
                  R subseteq B iff (for all x : T, x in R implies x in B)
                by sd_all at R
  have sd_ri : R subseteq (P inter Q) iff (for all x : T, x in R implies x in (P inter Q))
               by sd_ri1 at (P inter Q)
  have sd_back : (for all x : T, x in R implies x in (P inter Q)) ->
                   R subseteq (P inter Q)
                 by sd_ri
  then R subseteq P inter Q by sd_back and mem_dir
end

-- {} ⊆ A for any set A.
theorem empty_subset :
  for all T : Type, for all P : Set T,
    {} subseteq P
proof
  take T : Type
  take P : Set T
  have es1 : for all x : T, not (x in {})
             by empty_set at T
  have mem_dir : for all x : T, x in {} implies x in P
  proof
    take x : T
    suppose h_mem : x in {}
    have h_not : not (x in {}) by es1 at x
    have h_false : false by h_not and h_mem
    have h_p : x in P by h_false
    have impl : x in {} -> x in P by h_mem and h_p
    have fa   : for all x : T, x in {} -> x in P by impl
    then for all x : T, x in {} implies x in P by fa
  end
  have sd1 : for all A : Set T, for all B : Set T,
               A subseteq B iff (for all x : T, x in A implies x in B)
             by subset_def at T
  have sd2 : for all B : Set T,
               {} subseteq B iff (for all x : T, x in {} implies x in B)
             by sd1 at {}
  have sd3 : {} subseteq P iff (for all x : T, x in {} implies x in P)
             by sd2 at P
  have sd_back : (for all x : T, x in {} implies x in P) ->
                   {} subseteq P
                 by sd3
  then {} subseteq P by sd_back and mem_dir
end

-- Q ⊆ P ∪ Q.
theorem union_supset_right :
  for all T : Type, for all P : Set T, for all Q : Set T,
    Q subseteq P union Q
proof
  take T : Type
  take P : Set T
  take Q : Set T
  have ud1 : for all A : Set T, for all B : Set T, for all x : T,
               x in A union B iff (x in A or x in B)
             by union_def at T
  have ud2 : for all B : Set T, for all x : T,
               x in P union B iff (x in P or x in B)
             by ud1 at P
  have ud3 : for all x : T,
               x in P union Q iff (x in P or x in Q)
             by ud2 at Q
  have mem_dir : for all x : T, x in Q implies x in (P union Q)
  proof
    take x : T
    suppose h_q : x in Q
    have ud4 : x in P union Q iff (x in P or x in Q) by ud3 at x
    have fwd  : (x in P or x in Q) -> x in P union Q by ud4
    have h_or : x in P or x in Q by h_q
    have h_pu : x in P union Q by fwd and h_or
    have impl : x in Q -> x in P union Q by h_q and h_pu
    have fa   : for all x : T, x in Q -> x in P union Q by impl
    then for all x : T, x in Q implies x in (P union Q) by fa
  end
  have sd1 : for all A : Set T, for all B : Set T,
               A subseteq B iff (for all x : T, x in A implies x in B)
             by subset_def at T
  have sd2 : for all B : Set T,
               Q subseteq B iff (for all x : T, x in Q implies x in B)
             by sd1 at Q
  have sd3 : Q subseteq (P union Q) iff (for all x : T, x in Q implies x in (P union Q))
             by sd2 at (P union Q)
  have sd_back : (for all x : T, x in Q implies x in (P union Q)) ->
                   Q subseteq (P union Q)
                 by sd3
  then Q subseteq P union Q by sd_back and mem_dir
end
