-- Generic set theory axioms, parameterised over any element type T : Type.
--
-- Every axiom universally quantifies over T so these facts hold for Set Nat,
-- Set Real, Set (Nat -> Real), etc. without duplication.

-- ── Extensionality ──────────────────────────────────────────────────────────
axiom set_ext : for all T : Type, for all A : Set T, for all B : Set T, (for all x : T, x in A iff x in B) implies A = B

-- ── Empty set ────────────────────────────────────────────────────────────────
axiom empty_set : for all T : Type, for all x : T, not (x in {})

-- ── Union ────────────────────────────────────────────────────────────────────
axiom union_def    : for all T : Type, for all A : Set T, for all B : Set T, for all x : T, x in A union B iff (x in A or x in B)
axiom union_comm   : for all T : Type, for all A : Set T, for all B : Set T, A union B = B union A
axiom union_assoc  : for all T : Type, for all A : Set T, for all B : Set T, for all C : Set T, (A union B) union C = A union (B union C)
axiom union_empty  : for all T : Type, for all A : Set T, A union {} = A

-- ── Intersection ─────────────────────────────────────────────────────────────
axiom inter_def    : for all T : Type, for all A : Set T, for all B : Set T, for all x : T, x in A inter B iff (x in A and x in B)
axiom inter_comm   : for all T : Type, for all A : Set T, for all B : Set T, A inter B = B inter A
axiom inter_assoc  : for all T : Type, for all A : Set T, for all B : Set T, for all C : Set T, (A inter B) inter C = A inter (B inter C)

-- ── Set difference ──────────────────────────────────────────────────────────
axiom diff_def     : for all T : Type, for all A : Set T, for all B : Set T, for all x : T, x in A setminus B iff (x in A and not (x in B))

-- ── Subset ───────────────────────────────────────────────────────────────────
axiom subset_def   : for all T : Type, for all A : Set T, for all B : Set T, A subseteq B iff (for all x : T, x in A implies x in B)
axiom subset_refl  : for all T : Type, for all A : Set T, A subseteq A
axiom subset_trans : for all T : Type, for all A : Set T, for all B : Set T, for all C : Set T, A subseteq B implies B subseteq C implies A subseteq C
axiom subset_antisym : for all T : Type, for all A : Set T, for all B : Set T, A subseteq B implies B subseteq A implies A = B

-- ── De Morgan laws ──────────────────────────────────────────────────────────
axiom de_morgan_union : for all T : Type, for all A : Set T, for all B : Set T, for all x : T, not (x in A union B) iff (not (x in A) and not (x in B))
axiom de_morgan_inter : for all T : Type, for all A : Set T, for all B : Set T, for all x : T, not (x in A inter B) iff (not (x in A) or not (x in B))

-- ── Distributivity ──────────────────────────────────────────────────────────
axiom distrib_union_inter : for all T : Type, for all A : Set T, for all B : Set T, for all C : Set T, A union (B inter C) = (A union B) inter (A union C)
axiom distrib_inter_union : for all T : Type, for all A : Set T, for all B : Set T, for all C : Set T, A inter (B union C) = (A inter B) union (A inter C)
