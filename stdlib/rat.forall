-- Ordered field axioms for Rat
--
-- Q is an ordered field; the axioms mirror those for Real (real.forall)
-- but are stated independently for Rat.
--
-- Axiom names follow the convention  <TypeName>_<law>  so that
-- `instance Rat : OrderedField` can resolve them implicitly.

-- Additive group
axiom Rat_add_comm        : for all x : Rat, for all y : Rat, x + y = y + x
axiom Rat_add_assoc       : for all x : Rat, for all y : Rat, for all z : Rat, (x + y) + z = x + (y + z)
axiom Rat_add_zero        : for all x : Rat, x + 0 = x
axiom Rat_zero_add        : for all x : Rat, 0 + x = x
axiom Rat_add_neg         : for all x : Rat, there exists y : Rat, x + y = 0

-- Multiplicative group (on nonzero elements)
axiom Rat_mul_comm        : for all x : Rat, for all y : Rat, x * y = y * x
axiom Rat_mul_assoc       : for all x : Rat, for all y : Rat, for all z : Rat, (x * y) * z = x * (y * z)
axiom Rat_mul_one         : for all x : Rat, x * 1 = x
axiom Rat_one_mul         : for all x : Rat, 1 * x = x
axiom Rat_mul_inv         : for all x : Rat, not (x = 0) implies there exists y : Rat, x * y = 1

-- Distributivity
axiom Rat_distrib_left    : for all x : Rat, for all y : Rat, for all z : Rat, x * (y + z) = x * y + x * z
axiom Rat_distrib_right   : for all x : Rat, for all y : Rat, for all z : Rat, (x + y) * z = x * z + y * z

-- Order
axiom Rat_order_total     : for all x : Rat, for all y : Rat, x < y or x = y or y < x
axiom Rat_lt_trans        : for all x : Rat, for all y : Rat, for all z : Rat, x < y implies y < z implies x < z
axiom Rat_lt_add          : for all x : Rat, for all y : Rat, for all z : Rat, x < y implies x + z < y + z
axiom Rat_lt_mul_pos      : for all x : Rat, for all y : Rat, x > 0 implies y > 0 implies x * y > 0
axiom Rat_zero_lt_one     : 0 < 1

instance Rat : OrderedField
