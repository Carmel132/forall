import "int_equiv.forall"

-- Construction of ℤ as a quotient of ℕ × ℕ.
--
-- The carrier is pairs (a, b) : Nat * Nat representing a - b.
-- Two pairs are identified when they represent the same difference:
--   (a, b) ~ (c, d)  iff  a + d = b + c   (= int_equiv a b c d)
--
-- NatPair is the type alias for the carrier.
type NatPair = (Nat, Nat)

-- The integers as the quotient of NatPair by int_equiv.
-- Each equivalence class [a, b] represents the integer a - b.
--
-- The three axiom fields assert int_equiv is an equivalence relation.
-- These follow from int_equiv_refl, int_equiv_symm, int_equiv_trans
-- (proved in int_equiv.forall); they are re-stated here as quotient axioms
-- so the checker registers IntQ_refl, IntQ_symm, IntQ_trans in module_env.
quotient IntQ := NatPair over int_equiv
  axiom refl :
    for all a : Nat, for all b : Nat,
      a + b = b + a
  axiom symm :
    for all a : Nat, for all b : Nat, for all c : Nat, for all d : Nat,
      a + d = b + c implies c + b = d + a
  axiom trans :
    for all a : Nat, for all b : Nat, for all c : Nat,
    for all d : Nat, for all e : Nat, for all f : Nat,
      a + d = b + c implies c + f = d + e implies a + f = b + e

-- Canonical embedding: nat_to_intq n = [n, 0], the class of the pair (n, 0).
-- This injects Nat into IntQ faithfully (positive integers).
abstract definition nat_to_intq (n : Nat) : Prop

-- Distinguished elements: zero and one as IntQ constants.
-- zero = [(0, 0)], one = [(1, 0)].
abstract definition intq_zero : Prop
abstract definition intq_one  : Prop
