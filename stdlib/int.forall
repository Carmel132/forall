-- Signed-magnitude integers (ℤ).
--
-- Int is declared as an inductive type with two constructors:
--   pos(n : Nat)      -- represents the non-negative integer n
--   neg_succ(n : Nat) -- represents the negative integer -(n+1)
--
-- This mirrors Lean 4's Int.ofNat / Int.negSucc representation.
-- The inductive declaration auto-generates:
--   Int_ind             (induction principle)
--   pos_ne_neg_succ     (constructor disjointness)
--   pos_injective       (pos is injective)
--   neg_succ_injective  (neg_succ is injective)
--
-- Arithmetic operations are stated as axioms here; recursive definitions
-- live in int_arith.forall (imported by int_theorems.forall).
-- Axiom names follow Int_<law> so `instance Int : CommRing` resolves them.

inductive Int :=
  pos : Nat -> Int
  neg_succ : Nat -> Int

-- Every integer is non-negative or negative (case-split axiom).
axiom int_zero_or_neg_or_pos :
    for all n : Int,
        (there exists k : Nat, n = pos(k)) or
        (there exists k : Nat, n = neg_succ(k))

-- Additive group
axiom Int_add_comm        : for all x : Int, for all y : Int, x + y = y + x
axiom Int_add_assoc       : for all x : Int, for all y : Int, for all z : Int, (x + y) + z = x + (y + z)
axiom Int_add_zero        : for all x : Int, x + 0 = x
axiom Int_zero_add        : for all x : Int, 0 + x = x
axiom Int_add_neg         : for all x : Int, there exists y : Int, x + y = 0

-- Subtraction defined as addition of negation
axiom Int_sub_def         : for all x : Int, for all y : Int, there exists z : Int, x - y = x + z

-- Multiplicative monoid
axiom Int_mul_comm        : for all x : Int, for all y : Int, x * y = y * x
axiom Int_mul_assoc       : for all x : Int, for all y : Int, for all z : Int, (x * y) * z = x * (y * z)
axiom Int_mul_one         : for all x : Int, x * 1 = x
axiom Int_one_mul         : for all x : Int, 1 * x = x

-- Distributivity
axiom Int_distrib_left    : for all x : Int, for all y : Int, for all z : Int, x * (y + z) = x * y + x * z
axiom Int_distrib_right   : for all x : Int, for all y : Int, for all z : Int, (x + y) * z = x * z + y * z

-- Integral domain: no zero divisors; multiplicative cancellation
axiom Int_no_zero_div     : for all x : Int, for all y : Int, x * y = 0 implies x = 0 or y = 0
axiom Int_mul_left_cancel : for all x : Int, for all y : Int, for all z : Int,
    not (x = 0) implies x * y = x * z implies y = z

-- Order (ℤ is a totally ordered ring)
axiom Int_order_total     : for all x : Int, for all y : Int, x < y or x = y or y < x
axiom Int_lt_trans        : for all x : Int, for all y : Int, for all z : Int, x < y implies y < z implies x < z
axiom Int_lt_add          : for all x : Int, for all y : Int, for all z : Int, x < y implies x + z < y + z
axiom Int_lt_mul_pos      : for all x : Int, for all y : Int, x > 0 implies y > 0 implies x * y > 0
axiom Int_zero_lt_one     : 0 < 1

instance Int : CommRing
