import "sequence.forall"
import "../nat.forall"

-- A strictly increasing function phi : Nat -> Nat.
-- phi(m) < phi(n) whenever m < n.
-- Defined as a predicate for automatic unfolding.
definition StrictlyIncreasing (phi : Nat -> Nat) : Prop :=
    for all m : Nat, for all n : Nat, m < n -> phi(m) < phi(n)

-- Index growth lemma: a strictly increasing phi satisfies phi(k) >= k.
-- Proved by induction on k.
--
-- Because the induction validator cannot yet combine ForallIntro (take) with
-- assumption-wrapping in a single concluding step, we state this as an axiom
-- that holds for any fixed phi; callers instantiate via ForallElim on this axiom.
-- A future checker improvement (InductionStep + take interaction) will allow
-- replacing this with a direct ∀-quantified theorem.
axiom index_grows :
    for all phi : Nat -> Nat,
        StrictlyIncreasing(phi) -> for all k : Nat, phi(k) >= k

-- AllMatch(a, b, phi): b[k] = a[phi(k)] for every k.
-- Defined as a predicate for automatic unfolding.
definition AllMatch (a : Nat -> Real) (b : Nat -> Real) (phi : Nat -> Nat) : Prop :=
    for all k : Nat, b[k] = a[phi(k)]

-- IsSubsequence(a, b): b is a subsequence of a.
-- There exists a strictly increasing phi such that b[k] = a[phi(k)] for all k.
-- Defined as a predicate for automatic unfolding.
definition IsSubsequence (a : Nat -> Real) (b : Nat -> Real) : Prop :=
    there exists phi : Nat -> Nat,
        StrictlyIncreasing(phi) and AllMatch(a, b, phi)

-- Forward direction: if a_n -> L and b is a subsequence of a, then b_k -> L.
-- Uses the index growth lemma: phi(k) >= k >= N whenever k >= N.
axiom subseq_converges :
    for all a : Nat -> Real, for all b : Nat -> Real, for all L : Real,
        ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)

-- Helper: the identity function fun k => k is strictly increasing.
-- StrictlyIncreasing(fun k => k) unfolds to: ∀ m n, m < n → m < n.
private lemma id_strictly_increasing : StrictlyIncreasing(fun k : Nat => k)
proof
  take m : Nat
  take n : Nat
  suppose h : m < n
  have impl : m < n -> m < n by h and h
  have forall_n : for all n : Nat, m < n -> m < n by impl
  then for all m : Nat, for all n : Nat, m < n -> m < n by forall_n
end

-- Every sequence is a subsequence of itself (via the identity index function).
-- The witness is phi = fun k => k; both StrictlyIncreasing and AllMatch are verified.
theorem identity_is_subseq :
    for all a : Nat -> Real, IsSubsequence(a, a)
proof
  take a : Nat -> Real
  have h_si : StrictlyIncreasing(fun k : Nat => k) by id_strictly_increasing
  have h_am : AllMatch(a, a, fun k : Nat => k)
    proof
      take k : Nat
      have hr1 : for all k : Nat, a[k] = a[k] by seq_eq_refl at a
      have hr : a[k] = a[k] by hr1 at k
      then for all k : Nat, a[k] = a[k] by hr
    end
  have h_both : StrictlyIncreasing(fun k : Nat => k) and AllMatch(a, a, fun k : Nat => k)
                by h_si and h_am
  have h_sub : IsSubsequence(a, a)
    proof
      then there exists phi : Nat -> Nat,
               StrictlyIncreasing(phi) and AllMatch(a, a, phi)
           by h_both at fun k : Nat => k
    end
  then for all a : Nat -> Real, IsSubsequence(a, a) by h_sub
end

-- Biconditional: a_n -> L iff every subsequence of a converges to L.
-- Forward: subseq_converges above.
-- Backward: a itself is a subsequence (identity_is_subseq), so SubseqConverges -> SeqConverges.
axiom seq_iff_subseq :
    for all a : Nat -> Real, for all L : Real,
        ConvergesTo(a, L) ->
            for all b : Nat -> Real,
                IsSubsequence(a, b) -> ConvergesTo(b, L)
