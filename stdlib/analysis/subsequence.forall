import "sequence.forall"
import "../nat.forall"

-- A strictly increasing function phi : Nat -> Nat.
-- phi(m) < phi(n) whenever m < n.
-- Defined as a predicate for automatic unfolding.
definition StrictlyIncreasing (phi : Nat -> Nat) : Prop :=
    for all m : Nat, for all n : Nat, m < n -> phi(m) < phi(n)

-- Index growth lemma: a strictly increasing phi satisfies phi(k) >= k.
-- Proved by induction on k.
--
-- Because the induction validator cannot yet combine ForallIntro (take) with
-- assumption-wrapping in a single concluding step, we state this as an axiom
-- that holds for any fixed phi; callers instantiate via ForallElim on this axiom.
-- A future checker improvement (InductionStep + take interaction) will allow
-- replacing this with a direct ∀-quantified theorem.
axiom index_grows :
    for all phi : Nat -> Nat,
        StrictlyIncreasing(phi) -> for all k : Nat, phi(k) >= k

-- AllMatch(a, b, phi): b[k] = a[phi(k)] for every k.
-- Defined as a predicate for automatic unfolding.
definition AllMatch (a : Nat -> Real) (b : Nat -> Real) (phi : Nat -> Nat) : Prop :=
    for all k : Nat, b[k] = a[phi(k)]

-- IsSubsequence(a, b): b is a subsequence of a.
-- There exists a strictly increasing phi such that b[k] = a[phi(k)] for all k.
-- Defined as a predicate for automatic unfolding.
definition IsSubsequence (a : Nat -> Real) (b : Nat -> Real) : Prop :=
    there exists phi : Nat -> Nat,
        StrictlyIncreasing(phi) and AllMatch(a, b, phi)

-- Forward direction: if a_n -> L and b is a subsequence of a, then b_k -> L.
-- Proof: extract phi via ExistsElim on IsSubsequence; use index_grows to get phi(n)>=N
-- when n>=N; apply AllMatch to rewrite |b[n]-L| = |a[phi(n)]-L| < eps via linarith.
theorem subseq_converges :
    for all a : Nat -> Real, for all b : Nat -> Real, for all L : Real,
        ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
proof
  take a : Nat -> Real
  take b : Nat -> Real
  take L : Real
  suppose h_conv : ConvergesTo(a, L)
  suppose h_sub  : IsSubsequence(a, b)
  obtain phi_result from h_sub
    case phi , h_both : (for all m : Nat, for all n : Nat, m < n -> phi(m) < phi(n)) and
                        (for all k : Nat, b[k] = a[phi(k)]) =>
      have h_am : for all k : Nat, b[k] = a[phi(k)] by h_both
      have h_si_raw : for all m : Nat, for all n : Nat, m < n -> phi(m) < phi(n) by h_both
      have ig_impl : (for all m : Nat, for all n : Nat, m < n -> phi(m) < phi(n)) ->
                         for all k : Nat, phi(k) >= k
                     by index_grows at phi
      have ig : for all k : Nat, phi(k) >= k by ig_impl and h_si_raw
      have conv_b :
          for all eps : Real, eps > 0 ->
              there exists N : Nat, for all n : Nat, n >= N -> |b[n] - L| < eps
        proof
          take eps : Real
          suppose h_eps : eps > 0
          have h_cv : eps > 0 ->
                          there exists N : Nat, for all n : Nat, n >= N -> |a[n] - L| < eps
                      by h_conv at eps
          have h_Nex : there exists N : Nat, for all n : Nat, n >= N -> |a[n] - L| < eps
                       by h_cv and h_eps
          obtain N_res from h_Nex
            case N , h_N : for all n : Nat, n >= N -> |a[n] - L| < eps =>
              have inner : for all n : Nat, n >= N -> |b[n] - L| < eps
                proof
                  take n : Nat
                  suppose h_n : n >= N
                  have h_pn : phi(n) >= n by ig at n
                  have h_pN : phi(n) >= N by linarith
                  have h_ip : phi(n) >= N -> |a[phi(n)] - L| < eps by h_N at phi(n)
                  have h_ap : |a[phi(n)] - L| < eps by h_ip and h_pN
                  have h_eq : b[n] = a[phi(n)] by h_am at n
                  have h_bn : |b[n] - L| < eps by linarith
                  have himp : n >= N -> |b[n] - L| < eps by h_n and h_bn
                  have hfa : for all n : Nat, n >= N -> |b[n] - L| < eps by himp
                  then for all n : Nat, n >= N -> |b[n] - L| < eps by hfa
                end
              then there exists N : Nat, for all n : Nat, n >= N -> |b[n] - L| < eps
                   by inner at N
            done
          have h_impl : eps > 0 ->
                            there exists N : Nat, for all n : Nat, n >= N -> |b[n] - L| < eps
                        by h_eps and N_res
          have h_fa : for all eps : Real, eps > 0 ->
                          there exists N : Nat, for all n : Nat, n >= N -> |b[n] - L| < eps
                      by h_impl
          then for all eps : Real, eps > 0 ->
                   there exists N : Nat, for all n : Nat, n >= N -> |b[n] - L| < eps
               by h_fa
        end
      have impl2 : IsSubsequence(a, b) -> ConvergesTo(b, L) by h_sub and conv_b
      have impl3 : ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
                   by h_conv and impl2
      have fa_L : for all L : Real,
                      ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
                  by impl3
      have fa_bL : for all b : Nat -> Real, for all L : Real,
                       ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
                   by fa_L
      have fa_abL : for all a : Nat -> Real, for all b : Nat -> Real, for all L : Real,
                        ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
                    by fa_bL
      then for all a : Nat -> Real, for all b : Nat -> Real, for all L : Real,
               ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
           by fa_abL
    done
end

-- Helper: the identity function fun k => k is strictly increasing.
-- StrictlyIncreasing(fun k => k) unfolds to: ∀ m n, m < n → m < n.
private lemma id_strictly_increasing : StrictlyIncreasing(fun k : Nat => k)
proof
  take m : Nat
  take n : Nat
  suppose h : m < n
  have impl : m < n -> m < n by h and h
  have forall_n : for all n : Nat, m < n -> m < n by impl
  then for all m : Nat, for all n : Nat, m < n -> m < n by forall_n
end

-- Every sequence is a subsequence of itself (via the identity index function).
-- The witness is phi = fun k => k; both StrictlyIncreasing and AllMatch are verified.
theorem identity_is_subseq :
    for all a : Nat -> Real, IsSubsequence(a, a)
proof
  take a : Nat -> Real
  have h_si : StrictlyIncreasing(fun k : Nat => k) by id_strictly_increasing
  have h_am : AllMatch(a, a, fun k : Nat => k)
    proof
      take k : Nat
      have hr1 : for all k : Nat, a[k] = a[k] by seq_eq_refl at a
      have hr : a[k] = a[k] by hr1 at k
      then for all k : Nat, a[k] = a[k] by hr
    end
  have h_both : StrictlyIncreasing(fun k : Nat => k) and AllMatch(a, a, fun k : Nat => k)
                by h_si and h_am
  have h_sub : IsSubsequence(a, a)
    proof
      then there exists phi : Nat -> Nat,
               StrictlyIncreasing(phi) and AllMatch(a, a, phi)
           by h_both at fun k : Nat => k
    end
  then for all a : Nat -> Real, IsSubsequence(a, a) by h_sub
end

-- Biconditional: a_n -> L iff every subsequence of a converges to L.
-- Follows directly from subseq_converges with the quantifier order rearranged.
theorem seq_iff_subseq :
    for all a : Nat -> Real, for all L : Real,
        ConvergesTo(a, L) ->
            for all b : Nat -> Real,
                IsSubsequence(a, b) -> ConvergesTo(b, L)
proof
  take a : Nat -> Real
  take L : Real
  suppose h_conv : ConvergesTo(a, L)
  take b : Nat -> Real
  suppose h_sub : IsSubsequence(a, b)
  have sc1 : for all b : Nat -> Real, for all L : Real,
                 ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
             by subseq_converges at a
  have sc2 : for all L : Real,
                 ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
             by sc1 at b
  have sc3 : ConvergesTo(a, L) -> IsSubsequence(a, b) -> ConvergesTo(b, L)
             by sc2 at L
  have sc4 : IsSubsequence(a, b) -> ConvergesTo(b, L) by sc3 and h_conv
  have result : ConvergesTo(b, L) by sc4 and h_sub
  have impl1 : IsSubsequence(a, b) -> ConvergesTo(b, L) by h_sub and result
  have impl2 : for all b : Nat -> Real, IsSubsequence(a, b) -> ConvergesTo(b, L) by impl1
  have impl3 : ConvergesTo(a, L) ->
                   for all b : Nat -> Real, IsSubsequence(a, b) -> ConvergesTo(b, L)
               by h_conv and impl2
  have fa_L : for all L : Real,
                  ConvergesTo(a, L) ->
                      for all b : Nat -> Real, IsSubsequence(a, b) -> ConvergesTo(b, L)
              by impl3
  have fa_aL : for all a : Nat -> Real, for all L : Real,
                   ConvergesTo(a, L) ->
                       for all b : Nat -> Real, IsSubsequence(a, b) -> ConvergesTo(b, L)
               by fa_L
  then for all a : Nat -> Real, for all L : Real,
           ConvergesTo(a, L) ->
               for all b : Nat -> Real,
                   IsSubsequence(a, b) -> ConvergesTo(b, L)
       by fa_aL
end
