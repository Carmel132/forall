import "../algebra/real.forall"
import "../nat.forall"

namespace Analysis

-- A metric space is a set equipped with a distance function satisfying
-- non-negativity, identity of indiscernibles, symmetry, and the triangle inequality.
-- We model it as a structure; carrier and dist refer to abstract fields.

structure MetricSpace :=
    axiom dist_nonneg   : for all x : carrier, for all y : carrier, dist(x, y) >= 0
    axiom dist_self     : for all x : carrier, dist(x, x) = 0
    axiom dist_comm     : for all x : carrier, for all y : carrier, dist(x, y) = dist(y, x)
    axiom dist_triangle : for all x : carrier, for all y : carrier, for all z : carrier,
        dist(x, z) <= dist(x, y) + dist(y, z)

-- Convergence in a metric space: a_n -> L in (carrier, dist).
axiom MetricConvergesTo_def :
    for all a : Nat -> carrier, for all L : carrier,
        MetricConvergesTo(a, L) ->
            for all eps : Real, eps > 0 ->
                there exists N : Nat, for all n : Nat,
                    n >= N -> dist(a[n], L) < eps

-- A metric space Cauchy sequence.
axiom MetricCauchy_def :
    for all a : Nat -> carrier,
        MetricCauchy(a) ->
            for all eps : Real, eps > 0 ->
                there exists N : Nat, for all m : Nat, for all n : Nat,
                    m >= N -> n >= N -> dist(a[m], a[n]) < eps

-- A complete metric space: every Cauchy sequence converges.
axiom MetricComplete_def :
    IsComplete -> for all a : Nat -> carrier, MetricCauchy(a) ->
        there exists L : carrier, MetricConvergesTo(a, L)

end Analysis
