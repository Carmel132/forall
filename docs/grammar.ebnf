(* forall language grammar — EBNF *)
(* Notation: { } = zero or more, [ ] = optional, ( ) = grouping, | = choice *)


(* ── Comments ────────────────────────────────────────────────────────────── *)

(* Line comments begin with "--" and run to end of line.                 *)
(* They may appear anywhere whitespace is allowed.                        *)
(* Block comments are not supported.                                      *)


(* ── Unicode alternatives ────────────────────────────────────────────────── *)

(* Every keyword has a Unicode symbol equivalent.  Either form is valid   *)
(* anywhere the keyword appears; they produce identical AST nodes.        *)
(*                                                                         *)
(*   Keyword / ASCII form     │  Symbol  │  Notes                          *)
(*   ────────────────────────┼──────────┼────────────────────────────     *)
(*   "and"                   │  ∧       │  conjunction                    *)
(*   "or"                    │  ∨       │  disjunction                    *)
(*   "not"                   │  ¬       │  negation                       *)
(*   "->" / "implies"        │  →       │  implication                    *)
(*   "iff"                   │  ↔       │  biconditional                  *)
(*   "for all"               │  ∀       │  universal quantifier           *)
(*   "there exists"          │  ∃       │  existential quantifier         *)
(*   "false"                 │  ⊥       │  bottom / absurdity             *)
(*   "<="                    │  ≤       │  less-than-or-equal             *)
(*   ">="                    │  ≥       │  greater-than-or-equal          *)
(*   "/="                    │  ≠       │  not-equal                      *)
(*   "end" / "qed"           │  □       │  proof terminator               *)
(*                                                                         *)
(* Term-language Unicode symbols (implemented):                            *)
(*   "fun x => e"            │  λ x, e  │  lambda / anonymous function    *)
(*   "sum i : T, f i"        │  ∑       │  summation with binder          *)
(*   "prod i : T, f i"       │  ∏       │  aggregate product with binder  *)
(*   "floor(x)" / "ceil(x)"  │  ⌊x⌋/⌈x⌉│  floor and ceiling functions    *)
(*   "n!" (no Unicode alt.)  │  n!      │  factorial (postfix)            *)
(*   "f compose g"/"f circ g"│  f ∘ g   │  function composition           *)
(*   "inv f" (no Unicode alt.)│ (none)  │  function/group inverse (prefix)*)
(*                                                                         *)
(* Term-language symbols (implemented):                                     *)
(*   "x in S"                │  x ∈ S   │  set membership (proposition)   *)
(*   "x not in S"            │  x ∉ S   │  set non-membership             *)
(*   "A subseteq B"          │  A ⊆ B   │  subset-or-equal                *)
(*   "A subset B"            │  A ⊂ B   │  strict subset                  *)
(*   "A supseteq B"          │  A ⊇ B   │  superset-or-equal              *)
(*   "A union B"             │  A ∪ B   │  set union (expression)         *)
(*   "A inter B"             │  A ∩ B   │  set intersection               *)
(*   "A setminus B" / "A\B"  │  A ∖ B   │  set difference                 *)
(*   "compl A"               │  (none)  │  set complement (prefix)        *)
(*   "{a, b, c}" / "{}"      │          │  set literal                    *)
(*   "{x : T | P}" / "{x|P}" │          │  set comprehension              *)


(* ── Top level ───────────────────────────────────────────────────────────── *)

module      = { declaration } ;

declaration = axiom
            | definition
            | theorem
            | import
            | type_alias
            | inductive_decl
            | namespace_block
            | open_decl
            | alias_decl ;

axiom       = "axiom"                , identifier , ":" , prop ;
definition  = "definition"           , identifier , { param } , ":" , prop , [ ":=" , prop ] ;
theorem     = ( "theorem" | "lemma") , identifier , { param } , ":" , prop , proof_block ;
import      = "import" , string_lit ;

(* A type alias introduces a name that the checker transparently expands. *)
(* Example: type Sequence = Nat -> Real                                   *)
type_alias  = "type" , identifier , "=" , type ;

(* Inductive type declaration.  Each constructor lists its argument types  *)
(* separated by "->", with the return type (the type name) at the end.    *)
(* Example:                                                                *)
(*   inductive List :=                                                     *)
(*     nil  : List                                                         *)
(*     cons : Nat -> List -> List                                          *)
inductive_decl = "inductive" , identifier , ":=" ,
                 { identifier , ":" , { type , "->" } , identifier } ;

(* Namespace blocks group declarations under a qualified prefix.          *)
(* "namespace Nat ... end Nat" prefixes inner names as "Nat.name".        *)
(* "open Nat" brings all "Nat.*" names into scope unqualified.            *)
(* "open Nat in <decl>" scopes the open to a single declaration.          *)
namespace_block = "namespace" , identifier , { declaration } , "end" , identifier ;
open_decl       = "open" , identifier , [ "in" , declaration ] ;

(* Namespace alias — short name for a long qualified namespace.           *)
(* Example: alias Seq = Analysis.Sequence                                  *)
alias_decl  = "alias" , identifier , "=" , dotted_name ;
dotted_name = identifier , { "." , identifier } ;

param       = "(" , identifier , ":" , type , ")" ;


(* ── Proof blocks ────────────────────────────────────────────────────────── *)

proof_block = "proof" , { step } , ( "end" | "qed" | "□" ) ;

step = let_step
     | take_step
     | obtain_step
     | suppose_step
     | have_step
     | then_step
     | contradiction_step
     | cases_step
     | induction_step
     | rewrite_step
     | apply_step
     | exact_step
     | show_step
     | calc_step
     | split_step
     | push_neg_step
     | wlog_step ;

(* "let x be a Nat" introduces a term variable; deferred until term layer. *)
let_step    = "let" , identifier , ( "=" , expr | "be" , "a" , type ) ;

(* "take x" introduces a fresh arbitrary variable for ∀-intro.               *)
(* "fix" is a synonym.  "let n be arbitrary [in T]" is also accepted.        *)
(* The checker verifies x does not appear free in any assumption.             *)
(* After proving P(x), bare "then" closes the ∀ x, P goal automatically      *)
(* (pending LI1 — currently requires explicit "then ∀ x, P by h").           *)
(* Multiple takes nest: take x, take y produces ∀ x, ∀ y, P.                *)
take_step   = ( "take" | "fix" ) , identifier , [ ":" , type ]
            | "let" , identifier , "be" , "arbitrary" , [ "in" , type ] ;

(* "obtain" eliminates an existential hypothesis (∃-elim).                 *)
(* <exists_ref> must be ∃ x [: T], P.  The case arm introduces a fresh    *)
(* variable and names the instantiated hypothesis.  The arm sub-proof must *)
(* conclude some Q where x ∉ free(Q).  Without "done", obtain must be the *)
(* last step before end/qed; with "done", further steps may follow.        *)
obtain_step = "obtain" , identifier , "from" , ref ,
              "case" , identifier , [ ":" , type ] , "," ,
              identifier , ":" , prop , "=>" , { step } , [ "done" ] ;

(* "assume" and "suppose" are interchangeable.                            *)
(* "for contradiction" may use ":" or "that" as separator.               *)
(* Multiple assumptions: "suppose h1 : P and h2 : Q" desugars to two    *)
(* SupposeSteps.                                                          *)
suppose_step = ( "suppose" | "assume" ) ,
               [ "for" , "contradiction" , ( ":" | "that" ) ] ,
               identifier , ":" , prop ,
               { "and" , identifier , ":" , prop } ;

(* "we have" is an alias for "have". "at expr" provides a witness for     *)
(* ForallElim (hypothesis is ∀x.P) or ExistsIntro (conclusion is ∃x.P). *)
(* "from" is an alias for "by" in the justification clause.              *)
(* Use "_" as the name for an anonymous step; a fresh internal name is   *)
(* generated by the checker. Anonymous steps cannot be cited by name.    *)
(* "note that P by ..."/"observe that P by ..." produce an anonymous step *)
(* "since h1 and h2, have name : P" is sugar for "have name : P by h1 and h2". *)
(* "we know X" introduces an anonymous have-step citing X directly.      *)
have_step   = ( "have" | "we" , "have"
              | "note" , "that" | "observe" , "that"
              | "since" , justification , ","  , "have"
              | "we" , "know" ) ,
              [ ( identifier | "_" ) , ":" ] , prop ,
              [ ( "by" | "from" ) , justification , [ "at" , expr ] ] ;

(* "therefore", "thus", "hence", "so", "which gives", "which shows" are    *)
(* all aliases for "then".  "it follows that P" is also accepted.          *)
(* Omitting the "by" clause auto-discharges the most-recent matching       *)
(* Assumption when the conclusion is an implication (P → Q) or negation   *)
(* (¬P): ImplIntro or NotIntro is applied automatically.                   *)
(* Omitting the proposition ("then" or "then by refs") uses the theorem's  *)
(* goal as the conclusion — no need to re-state the statement.             *)
then_step   = ( "then" | "therefore" | "thus" | "hence" | "so"
              | "which" , "gives" | "which" , "shows"
              | "it" , "follows" , "that" ) ,
              [ prop ] ,
              [ ( "by" | "from" | "because" ) , justification , [ "at" , expr ] ] ;

(* Contradiction names the two contradictory hypotheses; it derives ⊥.   *)
(* "from" is an alias for ":" as the separator.                          *)
contradiction_step = "contradiction" , ( ":" | "from" ) , justification ;

(* Case analysis on a disjunctive hypothesis.  Each arm names and binds   *)
(* the case hypothesis, then provides sub-steps concluding the same goal. *)
(* <name> is the label under which the result is stored for later use.    *)
(* The optional "done" at the end of each arm allows further proof steps  *)
(* after the cases block.  Without "done", arms end on "case"/"end"/"qed" *)
(* and "cases" must be the last step before the proof terminator.         *)
(* The result label "<name> :" is optional; if omitted, the checker  *)
(* stores the result under a fresh internal name.                          *)
cases_step  = "cases" , [ identifier , ":" ] , ref ,
              { "case" , identifier , ":" , prop , "=>" , { step } , [ "done" ] } ;

(* Induction on a natural number variable.  "base:" proves P(0);         *)
(* "inductive:" has the induction hypothesis "ih : P(k)" in scope and    *)
(* must prove P(succ(k)).                                                 *)
(* For user-defined inductive types, use one "case <ctor> [vars] [ih]:"  *)
(* arm per constructor instead of base/inductive blocks.                 *)
induction_step = "induction" , identifier , "on" , identifier , ":" , prop ,
                 ( ( "base" , ":" , { step } , "inductive" , ":" , { step } )
                 | { "case" , identifier , { identifier } , ":" , { step } } ) ;

(* Rewrite one or more equalities into the current goal.                  *)
(* Rewrite one or more equalities or biconditionals into the current goal.  *)
(* "←" / "<-" reverses a = b to b = a before rewriting.                   *)
(* "↔" / "iff" prefix: h must be a biconditional P ↔ Q;                   *)
(*   forward (no ←): replaces P with Q in goal.                            *)
(*   reverse (with ←): replaces Q with P in goal.                          *)
(* Comma-separated rewrites are applied left-to-right.                   *)
rewrite_step   = "rewrite" , rewrite_item , { "," , rewrite_item } ;
rewrite_item   = [ ( "\xe2\x86\x94" | "iff" ) ] , [ ( "\xe2\x86\x90" | "<-" ) ] , ref ;

(* apply h — backward-applies an implication h : P → goal; new goal is P. *)
apply_step     = "apply" , ref ;

(* exact h — closes the current goal directly when h : goal.             *)
exact_step     = "exact" , ref ;

(* show P — documents the current goal; checker verifies P == goal.      *)
(* Aliases: "we need to show P", "it suffices to show P",               *)
(*          "we prove that P".                                            *)
show_step      = ( "show" | "we" , "need" , "to" , "show"
                 | "it" , "suffices" , "to" , "show"
                 | "we" , "prove" , "that" ) , prop ;

(* Equational / inequality reasoning chains.                              *)
(* "_" on a continuation line refers to the RHS of the previous line.    *)
(* Mixed relations are supported (pending LI4): = ∘ ≤ = ≤, ≤ ∘ < = <, etc. *)
calc_step      = "calc" , [ identifier , ":" ] ,
                 expr , rel , expr , "by" , justification ,
                 { ( rel | "_" ) , expr , "by" , justification } ;

(* Structured biconditional / conjunction proof.                          *)
(* Arms labelled "left"/"right" for ∧, "(→)"/"(←)" for ↔.              *)
split_step     = "split" , [ identifier , ":" ] ,
                 { split_arm } ;
split_arm      = ( "left" | "right" | "(→)" | "(←)" | "(->" | "(<-)" ) ,
                 ":" , { step } ;

(* Push negations inward using De Morgan's laws and classical equivalences. *)
(* "push neg" pushes through the goal; "push neg at h" transforms h.      *)
push_neg_step  = "push" , "neg" , [ "at" , ref ] ;

(* Without loss of generality — introduces an assumption with a warning   *)
(* that the symmetry side-obligation has not been verified.               *)
wlog_step      = "wlog" , [ identifier , ":" ] , prop ;


justification = ref , { ( "and" | "with" ) , ref } ;
(* "at expr" is a witness extension, written after "by <justification>":  *)
(*   have q : P(n) by forall_h at n          -- ForallElim               *)
(*   then ∃x.P by fact at n                  -- ExistsIntro              *)
(*                                                                          *)
(* Special justification sentinels (context-sensitive identifiers):        *)
(*   refl          -- proves a = a (Refl kernel rule)                      *)
(*   symm          -- proves b = a from a = b in scope (Symm kernel rule)  *)
(*   trans         -- proves a = c from a = b and b = c in scope (Trans)   *)
(*   congr         -- proves f(a)=f(b) from a=b in scope (Congr rule)      *)
(*   funext        -- proves f = g by pointwise equality (BI2)             *)
(*   decide        -- evaluates a closed arithmetic proposition             *)
(*   norm_num      -- checks a polynomial equality                         *)
(*   ring          -- checks a commutative ring identity                   *)
(*   omega         -- linear arithmetic over ℤ/ℕ                          *)
(*   linarith      -- linear arithmetic over ordered fields                *)
(*   simp          -- propositional simplification; "simp [h1,h2]" hints   *)
(*   field_simp    -- rational expression simplification                   *)
(*   positivity    -- proves expr ≥ 0 or expr > 0                         *)
(*   gcongr        -- congruence for monotone functions                    *)
(*   contra        -- closes P from ⊥ in scope (FalseElim)                *)
(*   contrapositive -- closes A→B from ¬B→¬A argument in scope            *)
(*   hypothesis    -- cites the unique active assumption in scope          *)
(*   assumption    -- alias for "hypothesis"                               *)
ref           = identifier ;


(* ── Propositions ────────────────────────────────────────────────────────── *)

prop        = quantifier | biconditional ;

(* Universal and existential quantifiers with optional type annotation.   *)
quantifier  = ( "for" , "all" | "∀" ) , binder , "," , prop
            | ( "there" , "exists" | "∃" ) , binder , "," , prop ;

(* A binder introduces one or more variables, optionally typed or bounded. *)
binder      = identifier , { "and" , identifier } , [ ":" , type ]
            | identifier , rel , expr ;

(* Biconditional (iff / ↔) — sugar for (A → B) ∧ (B → A). *)
biconditional = implication , [ ( "iff" | "↔" ) , biconditional ] ;

implication = "if" , prop , "then" , prop
            | disjunction , [ ( "->" | "→" | "implies" ) , implication ] ;

disjunction = conjunction , { ( "or"  | "∨" ) , conjunction } ;
conjunction = negation    , { ( "and" | "∧" ) , negation    } ;
negation    = ( "not" | "¬" ) , atomic_prop | atomic_prop ;

atomic_prop = "false" | "⊥"
            | "(" , prop , ")"
            | expr , rel , expr
            | expr , ( "in" | "∈" ) , expr                              (* set membership    *)
            | expr , ( "not" , "in" | "∉" ) , expr                     (* non-membership    *)
            | expr , ( "subseteq" | "⊆" ) , expr                       (* subset-or-equal   *)
            | expr , ( "subset"   | "⊂" ) , expr                       (* strict subset     *)
            | expr , ( "supseteq" | "⊇" ) , expr                       (* superset-or-equal *)
            | identifier , [ "(" , arg_list , ")" ] ;                  (* atom / predicate  *)


(* ── Expressions ─────────────────────────────────────────────────────────── *)

(* lambda, conditional, and aggregate operators are lowest precedence (bind loosest) *)
expr      = lambda | condExpr | sumExpr | prodExpr | exprAdd ;
lambda    = ( "fun" | "λ" ) , identifier , [ ":" , type ] , ( "=>" | "," ) , expr ;
condExpr  = "if" , prop , "then" , expr , "else" , expr ;
(* Note: "if P then Q" (no else) is the proposition-level implication handled by      *)
(* parseImplication.  The conditional expression "if P then a else b" (with else) is  *)
(* reachable from expression context: inside relational props, arg lists, etc.         *)
sumExpr   = ( "sum" | "∑" ) , aggBinder , "," , expr ;
prodExpr  = ( "prod" | "∏" ) , aggBinder , "," , expr ;
aggBinder = identifier , ":" , type     (* typed binder:   sum i : Nat, f i  *)
           | identifier , rel , expr ;  (* bounded binder: sum i < n, f i    *)
exprAdd   = exprMul , { ( "+" | "-" | "union" | "∪" | "setminus" | "\" ) , exprMul } ;
exprMul   = exprUnary , { ( "*" | "/" | "div" | "mod" | "compose" | "circ" | "∘" | "inter" | "∩" ) , exprUnary } ;
exprUnary = "-" , exprPow                                (* unary minus                        *)
           | "inv"   , exprPow                          (* function inverse: desugars inv(e)  *)
           | "compl" , exprPow                          (* set complement: desugars compl(e)  *)
           | exprPow ;
exprPow   = exprAtom , [ "^" , exprUnary ] ;           (* right-associative via exprUnary *)
exprAtom  = base , { "[" , expr , "]" | "!" } ;        (* subscript and factorial — left-assoc *)
base      = "|" , expr , "|"                            (* absolute value  |x - y|           *)
          | identifier , [ "(" , arg_list , ")" ]       (* variable or function call          *)
          | number
          | "(" , expr , ")"                            (* grouping — transparent             *)
          | "(" , expr , "," , expr , { "," , expr } , ")"  (* tuple  (a, b, c)             *)
          | "⌊" , expr , "⌋"                            (* floor — desugars to floor(expr)   *)
          | "⌈" , expr , "⌉"                            (* ceiling — desugars to ceil(expr)  *)
          | "{" , "}"                                   (* empty set literal                 *)
          | "{" , expr , { "," , expr } , "}"           (* set literal  {a, b, c}            *)
          | "{" , identifier , ":" , type , "|" , prop , "}"  (* set comprehension with type *)
          | "{" , identifier , "|" , prop , "}" ;       (* set comprehension without type    *)

arg_list = expr , { "," , expr } ;
(* Note: f(a, b) has two separate args; f((a, b)) has one tuple arg. *)


(* ── Types ───────────────────────────────────────────────────────────────── *)

(* Built-in numeric and logical types; user-defined structure/alias names via identifier. *)
(* Type aliases declared with "type A = T" expand transparently: A is interchangeable    *)
(* with T everywhere a type annotation is accepted.                                       *)
(* Function types are right-associative: Nat -> Nat -> Real = Nat -> (Nat -> Real).      *)
type = primitive_type , [ "->" , type ]
     | "(" , identifier , ":" , type , ")" , "->" , type    (* Π-type: (x : A) -> B *)
     | "(" , type , { "," , type } , ")"                    (* tuple type            *)
     | "Set" , type                                          (* set type: Set Nat     *)
     | identifier ;                                          (* user type or alias    *)

(* "Type" is the type of types (universe level 0).  "Type 1" contains     *)
(* "Type 0" itself.  In practice, bare "Type" is sufficient for generic  *)
(* theorems parameterised over a type.  Full universe levels (TU2) and   *)
(* universe-polymorphic binders (TU3) are future work.                   *)
primitive_type = "Real" | "Nat" | "Int" | "Rat" | "Prop"
               | "Type" , [ number ] ;   (* Type, Type 0, Type 1, ...  *)


(* ── Primitives ──────────────────────────────────────────────────────────── *)

rel        = "<" | ">" | "<=" | ">=" | "=" | "/="  (* ASCII arithmetic relational forms *)
           | "≤" | "≥" | "≠" ;                      (* Unicode U+2264 / U+2265 / U+2260 *)
identifier = letter , { letter | digit | "_" } ;
number     = digit  , { digit } , [ "." , { digit } ] ;
string_lit = '"' , { any_char } , '"' ;
letter     = "a" | ... | "z" | "A" | ... | "Z" ;
digit      = "0" | ... | "9" ;
