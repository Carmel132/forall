(* forall language grammar — EBNF *)
(* Notation: { } = zero or more, [ ] = optional, ( ) = grouping, | = choice *)


(* ── Comments ────────────────────────────────────────────────────────────── *)

(* Line comments begin with "--" and run to end of line.                 *)
(* They may appear anywhere whitespace is allowed.                        *)
(* Block comments are not supported.                                      *)


(* ── Unicode alternatives ────────────────────────────────────────────────── *)

(* Every keyword has a Unicode symbol equivalent.  Either form is valid   *)
(* anywhere the keyword appears; they produce identical AST nodes.        *)
(*                                                                         *)
(*   Keyword / ASCII form     │  Symbol  │  Notes                          *)
(*   ────────────────────────┼──────────┼────────────────────────────     *)
(*   "and"                   │  ∧       │  conjunction                    *)
(*   "or"                    │  ∨       │  disjunction                    *)
(*   "not"                   │  ¬       │  negation                       *)
(*   "->" / "implies"        │  →       │  implication                    *)
(*   "iff"                   │  ↔       │  biconditional                  *)
(*   "for all"               │  ∀       │  universal quantifier           *)
(*   "there exists"          │  ∃       │  existential quantifier         *)
(*   "false"                 │  ⊥       │  bottom / absurdity             *)
(*   "<="                    │  ≤       │  less-than-or-equal             *)
(*   ">="                    │  ≥       │  greater-than-or-equal          *)
(*   "/="                    │  ≠       │  not-equal                      *)
(*   "end" / "qed"           │  □       │  proof terminator               *)
(*                                                                         *)
(* Term-language Unicode symbols (implemented):                            *)
(*   "fun x => e"            │  λ x, e  │  lambda / anonymous function    *)
(*   "sum i : T, f i"        │  ∑       │  summation with binder          *)
(*   "prod i : T, f i"       │  ∏       │  aggregate product with binder  *)
(*   "floor(x)" / "ceil(x)"  │  ⌊x⌋/⌈x⌉│  floor and ceiling functions    *)
(*   "n!" (no Unicode alt.)  │  n!      │  factorial (postfix)            *)
(*   "f compose g"/"f circ g"│  f ∘ g   │  function composition           *)
(*   "inv f" (no Unicode alt.)│ (none)  │  function/group inverse (prefix)*)
(*                                                                         *)
(* Term-language symbols (implemented):                                     *)
(*   "x in S"                │  x ∈ S   │  set membership (proposition)   *)
(*   "x not in S"            │  x ∉ S   │  set non-membership             *)
(*   "A subseteq B"          │  A ⊆ B   │  subset-or-equal                *)
(*   "A subset B"            │  A ⊂ B   │  strict subset                  *)
(*   "A supseteq B"          │  A ⊇ B   │  superset-or-equal              *)
(*   "A union B"             │  A ∪ B   │  set union (expression)         *)
(*   "A inter B"             │  A ∩ B   │  set intersection               *)
(*   "A setminus B" / "A\B"  │  A ∖ B   │  set difference                 *)
(*   "compl A"               │  (none)  │  set complement (prefix)        *)
(*   "{a, b, c}" / "{}"      │          │  set literal                    *)
(*   "{x : T | P}" / "{x|P}" │          │  set comprehension              *)


(* ── Top level ───────────────────────────────────────────────────────────── *)

module      = { declaration } ;

declaration = axiom
            | definition
            | theorem
            | import ;

axiom       = "axiom"                , identifier , ":" , prop ;
definition  = "definition"           , identifier , { param } , ":" , prop ;
theorem     = ( "theorem" | "lemma") , identifier , ":" , prop , proof_block ;
import      = "import" , string_lit ;

param       = "(" , identifier , ":" , type , ")" ;


(* ── Proof blocks ────────────────────────────────────────────────────────── *)

proof_block = "proof" , { step } , ( "end" | "qed" | "□" ) ;

step = let_step
     | take_step
     | obtain_step
     | suppose_step
     | have_step
     | then_step
     | contradiction_step
     | cases_step ;

(* "let x be a Nat" introduces a term variable; deferred until term layer. *)
let_step    = "let" , identifier , ( "=" , expr | "be" , "a" , type ) ;

(* "take x" introduces a fresh arbitrary variable for ∀-intro.            *)
(* The checker verifies x does not appear free in any assumption; after    *)
(* proving P(x), the user writes "then ∀ x [: T], P by h" to generalize. *)
take_step   = "take" , identifier , [ ":" , type ] ;

(* "obtain" eliminates an existential hypothesis (∃-elim).                 *)
(* <exists_ref> must be ∃ x [: T], P.  The case arm introduces a fresh    *)
(* variable and names the instantiated hypothesis.  The arm sub-proof must *)
(* conclude some Q where x ∉ free(Q).  Without "done", obtain must be the *)
(* last step before end/qed; with "done", further steps may follow.        *)
obtain_step = "obtain" , identifier , "from" , ref ,
              "case" , identifier , [ ":" , type ] , "," ,
              identifier , ":" , prop , "=>" , { step } , [ "done" ] ;

(* "assume" and "suppose" are interchangeable.                            *)
(* "for contradiction" may use ":" or "that" as separator.               *)
suppose_step = ( "suppose" | "assume" ) ,
               [ "for" , "contradiction" , ( ":" | "that" ) ] ,
               [ identifier , ":" ] , prop ;

(* "we have" is an alias for "have". "at expr" provides a witness for     *)
(* ForallElim (hypothesis is ∀x.P) or ExistsIntro (conclusion is ∃x.P). *)
(* "from" is an alias for "by" in the justification clause.              *)
(* Use "_" as the name for an anonymous step; a fresh internal name is   *)
(* generated by the checker. Anonymous steps cannot be cited by name.    *)
have_step   = ( "have" | "we" , "have" ) ,
              ( identifier | "_" ) , ":" , prop , ( "by" | "from" ) , justification ,
              [ "at" , expr ] ;

(* "therefore" and "thus" are aliases for "then".                         *)
(* Omitting the "by" clause auto-discharges the most-recent matching      *)
(* Assumption when the conclusion is an implication (P → Q) or negation  *)
(* (¬P): ImplIntro or NotIntro is applied automatically.                  *)
then_step   = ( "then" | "therefore" | "thus" ) , prop ,
              [ ( "by" | "from" ) , justification , [ "at" , expr ] ] ;

(* Contradiction names the two contradictory hypotheses; it derives ⊥.   *)
(* "from" is an alias for ":" as the separator.                          *)
contradiction_step = "contradiction" , ( ":" | "from" ) , justification ;

(* Case analysis on a disjunctive hypothesis.  Each arm names and binds   *)
(* the case hypothesis, then provides sub-steps concluding the same goal. *)
(* <name> is the label under which the result is stored for later use.    *)
(* The optional "done" at the end of each arm allows further proof steps  *)
(* after the cases block.  Without "done", arms end on "case"/"end"/"qed" *)
(* and "cases" must be the last step before the proof terminator.         *)
(* The result label "<name> :" is optional (RL5); if omitted, the checker  *)
(* stores the result under a fresh internal name.                          *)
cases_step  = "cases" , [ identifier , ":" ] , ref ,
              { "case" , identifier , ":" , prop , "=>" , { step } , [ "done" ] } ;

justification = ref , { ( "and" | "with" ) , ref } ;
(* "at expr" is a witness extension, written after "by <justification>":  *)
(*   have q : P(n) by forall_h at n          -- ForallElim               *)
(*   then ∃x.P by fact at n                  -- ExistsIntro              *)
ref           = identifier ;


(* ── Propositions ────────────────────────────────────────────────────────── *)

prop        = quantifier | biconditional ;

(* Universal and existential quantifiers with optional type annotation.   *)
quantifier  = ( "for" , "all" | "∀" ) , binder , "," , prop
            | ( "there" , "exists" | "∃" ) , binder , "," , prop ;

(* A binder introduces one or more variables, optionally typed or bounded. *)
binder      = identifier , { "and" , identifier } , [ ":" , type ]
            | identifier , rel , expr ;

(* Biconditional (iff / ↔) — sugar for (A → B) ∧ (B → A). *)
biconditional = implication , [ ( "iff" | "↔" ) , biconditional ] ;

implication = "if" , prop , "then" , prop
            | disjunction , [ ( "->" | "→" | "implies" ) , implication ] ;

disjunction = conjunction , { ( "or"  | "∨" ) , conjunction } ;
conjunction = negation    , { ( "and" | "∧" ) , negation    } ;
negation    = ( "not" | "¬" ) , atomic_prop | atomic_prop ;

atomic_prop = "false" | "⊥"
            | "(" , prop , ")"
            | expr , rel , expr
            | expr , ( "in" | "∈" ) , expr                              (* set membership    *)
            | expr , ( "not" , "in" | "∉" ) , expr                     (* non-membership    *)
            | expr , ( "subseteq" | "⊆" ) , expr                       (* subset-or-equal   *)
            | expr , ( "subset"   | "⊂" ) , expr                       (* strict subset     *)
            | expr , ( "supseteq" | "⊇" ) , expr                       (* superset-or-equal *)
            | identifier , [ "(" , arg_list , ")" ] ;                  (* atom / predicate  *)


(* ── Expressions ─────────────────────────────────────────────────────────── *)

(* lambda, conditional, and aggregate operators are lowest precedence (bind loosest) *)
expr      = lambda | condExpr | sumExpr | prodExpr | exprAdd ;
lambda    = ( "fun" | "λ" ) , identifier , [ ":" , type ] , ( "=>" | "," ) , expr ;
condExpr  = "if" , prop , "then" , expr , "else" , expr ;
(* Note: "if P then Q" (no else) is the proposition-level implication handled by      *)
(* parseImplication.  The conditional expression "if P then a else b" (with else) is  *)
(* reachable from expression context: inside relational props, arg lists, etc.         *)
sumExpr   = ( "sum" | "∑" ) , aggBinder , "," , expr ;
prodExpr  = ( "prod" | "∏" ) , aggBinder , "," , expr ;
aggBinder = identifier , ":" , type     (* typed binder:   sum i : Nat, f i  *)
           | identifier , rel , expr ;  (* bounded binder: sum i < n, f i    *)
exprAdd   = exprMul , { ( "+" | "-" | "union" | "∪" | "setminus" | "\" ) , exprMul } ;
exprMul   = exprUnary , { ( "*" | "/" | "div" | "mod" | "compose" | "circ" | "∘" | "inter" | "∩" ) , exprUnary } ;
exprUnary = "-" , exprPow                                (* unary minus                        *)
           | "inv"   , exprPow                          (* function inverse: desugars inv(e)  *)
           | "compl" , exprPow                          (* set complement: desugars compl(e)  *)
           | exprPow ;
exprPow   = exprAtom , [ "^" , exprUnary ] ;           (* right-associative via exprUnary *)
exprAtom  = base , { "[" , expr , "]" | "!" } ;        (* subscript and factorial — left-assoc *)
base      = "|" , expr , "|"                            (* absolute value  |x - y|           *)
          | identifier , [ "(" , arg_list , ")" ]       (* variable or function call          *)
          | number
          | "(" , expr , ")"                            (* grouping — transparent             *)
          | "(" , expr , "," , expr , { "," , expr } , ")"  (* tuple  (a, b, c)             *)
          | "⌊" , expr , "⌋"                            (* floor — desugars to floor(expr)   *)
          | "⌈" , expr , "⌉"                            (* ceiling — desugars to ceil(expr)  *)
          | "{" , "}"                                   (* empty set literal                 *)
          | "{" , expr , { "," , expr } , "}"           (* set literal  {a, b, c}            *)
          | "{" , identifier , ":" , type , "|" , prop , "}"  (* set comprehension with type *)
          | "{" , identifier , "|" , prop , "}" ;       (* set comprehension without type    *)

arg_list = expr , { "," , expr } ;
(* Note: f(a, b) has two separate args; f((a, b)) has one tuple arg. *)


(* ── Types ───────────────────────────────────────────────────────────────── *)

(* Built-in numeric and logical types; user-defined types via identifier. *)
type = "Real" | "Nat" | "Int" | "Rat" | "Prop" | "Set" | "Sequence" | identifier ;


(* ── Primitives ──────────────────────────────────────────────────────────── *)

rel        = "<" | ">" | "<=" | ">=" | "=" | "/="  (* ASCII arithmetic relational forms *)
           | "≤" | "≥" | "≠" ;                      (* Unicode U+2264 / U+2265 / U+2260 *)
identifier = letter , { letter | digit | "_" } ;
number     = digit  , { digit } , [ "." , { digit } ] ;
string_lit = '"' , { any_char } , '"' ;
letter     = "a" | ... | "z" | "A" | ... | "Z" ;
digit      = "0" | ... | "9" ;
