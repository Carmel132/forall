{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "forall",
  "scopeName": "source.forall",
  "fileTypes": ["forall"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#declaration-keyword" },
    { "include": "#proof-structure" },
    { "include": "#proof-justification" },
    { "include": "#quantifier-phrase" },
    { "include": "#not-in" },
    { "include": "#logical-connective" },
    { "include": "#term-operator" },
    { "include": "#set-operator" },
    { "include": "#relational-operator" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "comment": {
      "name": "comment.line.double-dash.forall",
      "match": "--.*$"
    },

    "string": {
      "name": "string.quoted.double.forall",
      "begin": "\"",
      "end": "\"",
      "patterns": []
    },

    "number": {
      "name": "constant.numeric.forall",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },

    "declaration-keyword": {
      "name": "storage.type.forall",
      "match": "\\b(axiom|theorem|lemma|definition|import|namespace|open|type|structure|quotient|instance)\\b"
    },

    "proof-structure": {
      "name": "keyword.control.proof.forall",
      "match": "\\b(proof|end|qed|suppose|assume|have|then|therefore|thus|hence|so|contradiction|cases|case|done|let|be|on|take|obtain|induction|base|inductive|show|exact|rewrite|apply|calc|split|wlog|suffices|match|true|push|neg|we)\\b|□"
    },

    "proof-justification": {
      "name": "keyword.operator.proof.forall",
      "match": "\\b(by|with|at|from|because|decide|norm_num|ring|linarith|nlinarith|omega|simp|field_simp|positivity|gcongr|contra|contrapositive|refl|symm|trans|congr|eq_subst|funext|hypothesis|assumption)\\b"
    },

    "quantifier-phrase": {
      "patterns": [
        {
          "name": "keyword.operator.quantifier.forall",
          "match": "\\bfor\\s+all\\b|\\bthere\\s+exists\\b"
        },
        {
          "name": "keyword.operator.quantifier.forall",
          "match": "[∀∃]"
        }
      ]
    },

    "not-in": {
      "name": "keyword.operator.set.forall",
      "match": "\\bnot\\s+in\\b"
    },

    "logical-connective": {
      "name": "keyword.operator.logical.forall",
      "match": "\\b(and|or|not|implies|iff|false)\\b|[∧∨¬↔⊥→←]|->"
    },

    "term-operator": {
      "name": "keyword.operator.term.forall",
      "match": "\\b(fun|if|else|sum|prod|compose|circ|inv|div|mod|in)\\b|[λ∑∏∘⌊⌋⌈⌉]|=>"
    },

    "set-operator": {
      "name": "keyword.operator.set.forall",
      "match": "\\b(union|inter|setminus|subseteq|subset|supseteq|compl)\\b|[∪∩∖∈∉⊆⊂⊇]|\\\\"
    },

    "relational-operator": {
      "name": "keyword.operator.relational.forall",
      "match": "<=|>=|/=|<|>|=|[≤≥≠]"
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.forall",
          "match": "[,]"
        },
        {
          "name": "punctuation.definition.forall",
          "match": ":"
        },
        {
          "name": "punctuation.definition.pipe.forall",
          "match": "\\|"
        }
      ]
    }

  }
}
